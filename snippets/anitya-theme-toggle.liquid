{% comment %}
  Sun/moon toggle for the Shopify header.
  Add {% render 'anitya-theme-toggle' %} to the header, left of the search icon.
  Also add the inline script and CSS below to the theme.liquid <head>.
{% endcomment %}
<button class="anitya-theme-toggle" onclick="toggleAnityaTheme()" aria-label="Light or dark">
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/>
  </svg>
</button>
