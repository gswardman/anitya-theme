</section>

</div>{%- comment -%} /wrap {%- endcomment -%}
</div>{%- comment -%} /.an {%- endcomment -%}

{%- comment -%} ── Interactive hero JS ── {%- endcomment -%}
<script>
(function(){
  /* ── Set definitions ── */
  var SETS={
    sun:{id:'sun',hint:{{ section.settings.hint_sun | json }},headline:{{ section.settings.hero_sun | json }},lo:{{ section.settings.lo_sun | json }},hi:{{ section.settings.hi_sun | json }}},
    lot:{id:'lot',hint:{{ section.settings.hint_lot | json }},headline:{{ section.settings.hero_lot | json }},lo:{{ section.settings.lo_lot | json }},hi:{{ section.settings.hi_lot | json }}},
    wav:{id:'wav',hint:{{ section.settings.hint_wav | json }},headline:{{ section.settings.hero_wav | json }},lo:{{ section.settings.lo_wav | json }},hi:{{ section.settings.hi_wav | json }}},
    sit:{id:'sit',hint:{{ section.settings.hint_sit | json }},headline:{{ section.settings.hero_sit | json }},lo:{{ section.settings.lo_sit | json }},hi:{{ section.settings.hi_sit | json }}}
  };

  var curSet='sun', curLevel=5;
  var $h=document.getElementById('an-headline');
  var $hint=document.getElementById('an-hint');
  var $lo=document.getElementById('an-lo');
  var $hi=document.getElementById('an-hi');
  var $vibes=document.getElementById('an-vibes');
  var $chart=document.getElementById('an-chart');
  var $trend=document.getElementById('an-trend');

  /* ── Build vibe buttons ── */
  function renderBtns(){
    var s=SETS[curSet];
    var html='';
    for(var i=1;i<=6;i++){
      var sel=i===curLevel;
      var hi=i>=3;
      html+='<button class="vibe-btn'+(hi?' hi':'')+'" type="button" aria-pressed="'+(sel?'true':'false')+'" aria-label="'+s.id+' level '+i+' of 6" data-n="'+i+'">';
      html+='<svg viewBox="0 0 24 24"><use href="#'+s.id+i+'"/></svg>';
      if(i===1) html+='<span class="vb-label">'+s.lo+'</span>';
      if(i===6) html+='<span class="vb-label">'+s.hi+'</span>';
      html+='</button>';
    }
    $vibes.innerHTML=html;
    $vibes.querySelectorAll('.vibe-btn').forEach(function(b){
      b.addEventListener('click',function(){
        curLevel=parseInt(this.getAttribute('data-n'));
        renderBtns();
        renderChart();
      });
    });
  }

  /* ── Set switcher ── */
  document.querySelectorAll('.picker-set').forEach(function(b){
    b.addEventListener('click',function(){
      var s=this.getAttribute('data-set');
      curSet=s;
      document.querySelectorAll('.picker-set').forEach(function(x){x.setAttribute('aria-pressed','false')});
      this.setAttribute('aria-pressed','true');
      var d=SETS[s];
      $h.textContent=d.headline;
      $hint.textContent=d.hint;
      $lo.textContent=d.lo;
      $hi.textContent=d.hi;
      renderBtns();
      renderChart();
    });
  });

  /* ── Generate sample series ── */
  function makeSeries(target){
    var pts=[];
    var v=1.5+Math.random()*0.8;
    for(var i=0;i<30;i++){
      var progress=i/29;
      var drift=(target-v)*progress;
      v+=drift*0.12+(Math.random()-0.5)*0.6;
      if(v<1)v=1;if(v>6)v=6;
      pts.push(v);
    }
    pts[29]=target;
    return pts;
  }

  /* ── 7-day trailing average ── */
  function trailingAvg(pts){
    var avg=[];
    for(var i=0;i<pts.length;i++){
      var start=Math.max(0,i-6);
      var sum=0;
      for(var j=start;j<=i;j++) sum+=pts[j];
      avg.push(sum/(i-start+1));
    }
    return avg;
  }

  /* ── Render chart ── */
  function renderChart(){
    var W=380,H=140,pad=4;
    var pts=makeSeries(curLevel);
    var avg=trailingAvg(pts);
    var lastAvg=avg[avg.length-1];

    /* trend sentence */
    if(lastAvg>=4.4) $trend.textContent='Steady, and sunnier for weeks.';
    else if(lastAvg>=3) $trend.textContent='Climbing.';
    else $trend.textContent='Early days. It moves.';

    /* SVG */
    function x(i){return pad+(W-2*pad)*i/29}
    function y(v){return H-pad-(H-2*pad)*(v-1)/5}

    var svg='<svg viewBox="0 0 '+W+' '+H+'" width="100%" height="100%" style="display:block">';
    /* grid lines for levels 1-6 */
    svg+='<g class="chart-grid">';
    for(var g=1;g<=6;g++){
      var gy=y(g);
      svg+='<line x1="'+pad+'" y1="'+gy+'" x2="'+(W-pad)+'" y2="'+gy+'"/>';
    }
    svg+='</g>';
    /* dots */
    svg+='<g class="chart-dots">';
    for(var i=0;i<30;i++){
      svg+='<circle cx="'+x(i)+'" cy="'+y(pts[i])+'" r="2.5"/>';
    }
    svg+='</g>';
    /* average line */
    var d='M';
    for(var i=0;i<30;i++){
      d+=(i?'L':'')+x(i).toFixed(1)+','+y(avg[i]).toFixed(1);
    }
    svg+='<path class="chart-line" d="'+d+'"/>';
    /* end dot with halo */
    var ex=x(29),ey=y(avg[29]);
    svg+='<circle class="chart-halo" cx="'+ex+'" cy="'+ey+'" r="8"/>';
    svg+='<circle class="chart-end" cx="'+ex+'" cy="'+ey+'" r="4"/>';
    svg+='</svg>';
    $chart.innerHTML=svg;
  }

  /* ── Init ── */
  renderBtns();
  renderChart();
})();
</script>

