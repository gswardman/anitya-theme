        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="phone"><div class="screen">
      <img src="{{ 'anitya-week.png' | asset_url }}" alt="Anitya week view: the seven-day vibe line, the sit grid, and the journal" width="760" height="1301" loading="lazy">
    </div></div>
  </div>
  <div class="oura-strip"><strong>{{ section.settings.oura_bold }}</strong> {{ section.settings.oura_text }}</div>
</section>

{%- comment -%} ── 4.5 What free means ── {%- endcomment -%}
<section class="section" id="free">
  <div class="section-head">
    <p class="eyebrow">{{ section.settings.free_eyebrow }}</p>
    <h2>{{ section.settings.free_title }}</h2>
  </div>
  <div class="free-grid">
    {%- for block in section.blocks -%}
