    <div class="vibe-btns" id="an-vibes" role="group" aria-label="Tap a vibe level"></div>
    <div class="vibe-end-labels"><span id="an-lo">{{ section.settings.lo_sun }}</span><span id="an-hi">{{ section.settings.hi_sun }}</span></div>

    <div class="hero-actions">
      <a class="btn" href="{{ section.settings.app_url }}" data-cta="app-signup">{{ section.settings.cta_label }}</a>
      <span class="hero-signin">{{ section.settings.signin_text }} <a href="{{ section.settings.app_url }}">{{ section.settings.signin_link }}</a></span>
