<style>
  /* ── Base ── */
  .an{--bg:#15140f;--ink:#efe9dc;--ink2:#b8af9c;--muted:#9a927f;--dim:#5f5949;--line:#2b2820;--line2:#3a362c;--amber:#d9a86c;--card:#1a1813;--warm:#2b2820;--sel:#2b2820;
    --display:Fraunces,Georgia,"Times New Roman",serif;--body:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;
    background:var(--bg);color:var(--ink);font:16px/1.55 var(--body);-webkit-font-smoothing:antialiased}
  [data-theme="light"] .an{--bg:#FFFFFF;--ink:#1E1B16;--ink2:#4A443A;--muted:#6B655A;--dim:#8E877B;--line:#E5E5E2;--line2:#D9D9D5;--amber:#A0621C;--card:#FBFBFA;--warm:#F6F1E8;--sel:#F6F1E8}
  .an *{box-sizing:border-box}
  .an .wrap{max-width:1040px;margin:0 auto;padding-left:max(20px,env(safe-area-inset-left,0px));padding-right:max(20px,env(safe-area-inset-right,0px))}
  .an h1,.an h2,.an h3{font-family:var(--display);font-weight:300;letter-spacing:-.012em;line-height:1.08;margin:0;text-wrap:balance;color:var(--ink)}
  .an h1{font-size:clamp(40px,7vw,76px);min-height:2.2em}
  .an h2{font-size:clamp(30px,4.2vw,46px)}
  .an p{margin:0}
  .an a{color:inherit}
  .an .eyebrow{font:500 12px/1.4 var(--body);letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
  .an .lede{font-family:var(--display);font-weight:300;font-size:clamp(19px,2.2vw,24px);line-height:1.4;color:var(--ink2);max-width:34em}
  .an .small{font-size:13px;color:var(--muted)}
  .an .fine{font-size:13px;color:var(--muted);max-width:40em}
  .an .fine b,.an .fine strong{color:var(--ink2);font-weight:500}
  .an .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:0 24px;border-radius:14px;background:var(--ink);color:var(--bg);border:0;font:500 15px var(--body);cursor:pointer;text-decoration:none;white-space:nowrap}
  .an .btn:hover{opacity:.88}
  .an .btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line2)}
  .an .btn:focus-visible,.an a:focus-visible,.an button:focus-visible{outline:2px solid var(--amber);outline-offset:3px}
  .an .text-link{font-size:14px;color:var(--muted);text-decoration:underline;text-underline-offset:3px}
  .an .text-link:hover{color:var(--ink)}

  /* ── Black Friday bar ── */
  .an-bf{background:var(--amber);color:#fff;text-align:center;padding:10px 20px;font:500 14px/1.4 var(--body)}
  .an-bf a{color:#fff;text-decoration:none}
  .an-bf a:hover{text-decoration:underline}

  /* ── Hero ── */
  .an .hero{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center;padding-block:72px 48px}
  .an .copy{display:flex;flex-direction:column;gap:22px;min-width:0}
  .an .hero-actions{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
  .an .hero-signin{font-size:13px;color:var(--muted)}
  .an .hero-signin a{color:var(--muted);text-decoration:underline;text-underline-offset:3px}
  .an .hero-signin a:hover{color:var(--ink)}

  /* ── Vibe picker ── */
  .an .picker-row{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
  .an .picker-hint{font-size:13px;color:var(--muted);white-space:nowrap}
  .an .picker-sets{display:flex;gap:4px}
  .an .picker-set{background:none;border:none;padding:6px 10px;font:500 14px var(--body);color:var(--muted);cursor:pointer;border-radius:8px;white-space:nowrap}
  .an .picker-set:hover{color:var(--ink)}
  .an .picker-set[aria-pressed="true"]{color:var(--amber);text-decoration:underline;text-decoration-color:var(--amber);text-underline-offset:4px}
  .an .vibe-btns{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin-top:4px}
  .an .vibe-btn{display:flex;flex-direction:column;align-items:center;gap:4px;min-height:56px;min-width:44px;padding:8px 4px;border:2px solid transparent;border-radius:14px;background:none;cursor:pointer;color:var(--muted)}
  .an .vibe-btn.hi{color:var(--amber)}
  .an .vibe-btn[aria-pressed="true"]{border-color:var(--amber);background:var(--sel)}
  .an .vibe-btn:focus-visible{outline:2px solid var(--amber);outline-offset:2px}
  .an .vibe-btn svg{width:26px;height:26px;flex-shrink:0}
  .an .vibe-btn .vb-label{font-size:10px;line-height:1.2;text-align:center;opacity:.7}
  .an .vibe-end-labels{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-top:2px}

  /* ── Chart card ── */
  .an .chart-card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:24px;max-width:420px;width:100%}
  .an .chart-title{font:500 16px/1.3 var(--body);color:var(--ink);margin-bottom:4px}
  .an .chart-trend{font-size:14px;color:var(--ink2);margin-bottom:2px}
  .an .chart-explain{font-size:12px;color:var(--muted)}
  .an .chart-label{font-size:11px;color:var(--muted);display:flex;justify-content:space-between;margin-top:6px}
  .an .chart-area{position:relative;height:140px;margin:16px 0 4px}
  .an .chart-grid{position:absolute;inset:0}
  .an .chart-grid line{stroke:var(--line);stroke-width:1}
  .an .chart-dots circle{fill:var(--line)}
  .an .chart-line{fill:none;stroke:var(--amber);stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  .an .chart-end{fill:var(--amber)}
  .an .chart-halo{fill:var(--amber);opacity:.2}

  /* ── Sections shared ── */
  .an .section{padding-block:72px}
  .an .section+.section{border-top:1px solid var(--line)}
  .an .section-head{display:flex;flex-direction:column;gap:10px;margin-bottom:32px}

  /* ── App section ── */
  .an .app-grid{display:grid;grid-template-columns:1fr auto;gap:48px;align-items:start}
  .an .app-items{display:grid;gap:0}
  .an .app-item{border-top:1px solid var(--line);padding:18px 0}
  .an .app-item strong{display:block;color:var(--ink);font-weight:500;margin-bottom:4px}
  .an .app-item p{color:var(--ink2);font-size:15px;line-height:1.5}
  .an .phone{position:relative;border-radius:40px;background:#0d0c09;padding:12px;border:1px solid var(--line2);max-width:260px;width:100%}
  [data-theme="light"] .an .phone{box-shadow:0 24px 60px rgba(30,27,22,.18)}
  .an .phone .screen{border-radius:30px;overflow:hidden;background:var(--bg);aspect-ratio:760/1301}
  .an .phone img{display:block;width:100%;height:100%;object-fit:cover;object-position:top}
  .an .oura-strip{padding:18px 0;font-size:14px;color:var(--ink2);border-top:1px solid var(--line)}
  .an .oura-strip strong{color:var(--ink);font-weight:500}

  /* ── What free means ── */
  .an .free-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:28px}
  .an .free-item strong{display:block;color:var(--ink);font-weight:500;margin-bottom:6px;font-size:15px}
  .an .free-item p{color:var(--ink2);font-size:14px;line-height:1.5}

  /* ── The Calm Shelf ── */
  .an .shelf-card{display:grid;grid-template-columns:1fr 1fr;gap:0;border-radius:20px;overflow:hidden;border:1px solid var(--line)}
  .an .shelf-img{background:#EFE9DC;display:flex;align-items:center;justify-content:center;padding:32px}
  .an .shelf-img img{max-width:100%;height:auto;border-radius:12px}
  .an .shelf-text{padding:32px;display:flex;flex-direction:column;gap:14px;justify-content:center}
  .an .shelf-label{font:500 12px/1.4 var(--body);letter-spacing:.1em;text-transform:uppercase;color:var(--amber)}
  .an .shelf-title{font:500 22px/1.2 var(--body);color:var(--ink)}
  .an .shelf-body{font-size:15px;line-height:1.55;color:var(--ink2)}
  .an .shelf-guarantee{font-size:14px;color:var(--ink);font-weight:500}
  .an .shelf-small{font-size:13px;color:var(--muted)}
  .an .shelf-after{font-size:14px;color:var(--muted);margin-top:20px}

  /* ── Warm band (fund) ── */
  .an .warm-band{background:var(--warm);padding-block:72px;margin-inline:calc(-1 * max(20px,env(safe-area-inset-left,0px)));padding-inline:max(20px,env(safe-area-inset-left,0px))}
  .an .warm-inner{max-width:1040px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:48px;padding-left:max(20px,env(safe-area-inset-left,0px));padding-right:max(20px,env(safe-area-inset-right,0px))}
  .an .warm-text{display:flex;flex-direction:column;gap:14px}
  .an .warm-text p{font-size:16px;line-height:1.55;color:var(--ink2)}
  .an .warm-link{font-size:15px;color:var(--amber);text-decoration:none;font-weight:500}
  .an .warm-link:hover{text-decoration:underline}

  /* ── About ── */
  .an .about{display:grid;grid-template-columns:.8fr 1.2fr;gap:48px}
  .an .about-text{display:flex;flex-direction:column;gap:16px}
  .an .about-text p{font-family:var(--display);font-weight:300;font-size:21px;line-height:1.45;color:var(--ink2);max-width:30em}
  .an .about-sign{font-family:var(--body);font-size:14px;color:var(--muted);margin-top:10px}

  /* ── Closing CTA ── */
  .an .closing{text-align:center;display:flex;flex-direction:column;align-items:center;gap:16px}

  /* ── Footer ── */
  .an .an-footer{border-top:1px solid var(--line);padding-block:32px;text-align:center;font-size:13px;color:var(--muted);display:flex;flex-direction:column;gap:8px;align-items:center}
  .an .an-footer-powered{display:flex;gap:4px;align-items:center}
  .an .an-footer-powered .heart{color:var(--amber)}
  .an .an-footer a{color:var(--muted);text-decoration:none}
  .an .an-footer a:hover{color:var(--ink);text-decoration:underline}
  .an .an-footer-links{display:flex;gap:16px;flex-wrap:wrap;justify-content:center}

  /* ── Responsive ── */
  @media(max-width:860px){
    .an .hero{grid-template-columns:1fr;gap:36px;padding-block:48px 32px}
    .an h1{min-height:0}
    .an .app-grid{grid-template-columns:1fr;gap:36px}
    .an .app-grid .phone{margin:0 auto}
    .an .free-grid{grid-template-columns:1fr 1fr;gap:20px}
    .an .shelf-card{grid-template-columns:1fr}
    .an .warm-inner{grid-template-columns:1fr;gap:28px}
    .an .about{grid-template-columns:1fr;gap:28px}
    .an .vibe-btn{min-height:52px;border-radius:12px}
  }
  @media(max-width:480px){
    .an .free-grid{grid-template-columns:1fr}
  }
  @media(prefers-reduced-motion:reduce){.an *{transition:none!important}}
</style>

<div class="an" id="an-{{ section.id }}">

{%- comment -%} ── 4.1 Black Friday bar ── {%- endcomment -%}
{%- if section.settings.bf_show -%}
<div class="an-bf"><a href="{{ section.settings.bf_link }}" data-cta="bf-bar">{{ section.settings.bf_text }}</a></div>
{%- endif -%}

<div class="wrap">

{%- comment -%} ── 4.3 Hero ── {%- endcomment -%}
<section class="hero" id="top">
