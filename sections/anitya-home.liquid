    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 id="an-headline">{{ section.settings.hero_sun }}</h1>
    <p class="lede">{{ section.settings.lede }}</p>

    <div class="picker-row">
      <span class="picker-hint" id="an-hint">{{ section.settings.hint_sun }}</span>
