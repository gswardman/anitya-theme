      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{%- comment -%} ── 4.6 The Calm Shelf ── {%- endcomment -%}
<section class="section" id="shelf">
  <div class="section-head">
    <p class="eyebrow">{{ section.settings.shelf_eyebrow }}</p>
    <h2>{{ section.settings.shelf_title }}</h2>
