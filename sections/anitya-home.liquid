    <div class="chart-trend" id="an-trend"></div>
    <div class="chart-explain">{{ section.settings.chart_explain }}</div>
    <div class="chart-area" id="an-chart"></div>
    <div class="chart-label"><span>{{ section.settings.chart_lo }}</span><span>{{ section.settings.chart_hi }}</span></div>
  </div>
</section>

{%- comment -%} ── 4.4 The app ── {%- endcomment -%}
<section class="section" id="app">
  <div class="section-head">
    <p class="eyebrow">{{ section.settings.app_eyebrow }}</p>
    <h2>{{ section.settings.app_title }}</h2>
  </div>
