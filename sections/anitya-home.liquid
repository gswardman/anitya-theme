    {"type":"url","id":"bf_link","label":"Bar link","default":"/products/calm-stack"},

    {"type":"header","content":"Hero"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Gratitude and meditation journal · free"},
    {"type":"text","id":"lede","label":"Lede","default":"Sit for a few minutes. Write three things you're grateful for. Tap how you feel. Meditation and gratitude work better together, and your line shows it."},
    {"type":"url","id":"app_url","label":"App URL","default":"https://app.anityalabs.com"},
    {"type":"text","id":"cta_label","label":"Primary button","default":"Get access to the app"},
    {"type":"text","id":"signin_text","label":"Sign-in text","default":"Already have an account?"},
