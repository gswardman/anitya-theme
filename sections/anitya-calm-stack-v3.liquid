<div class="small" style="margin-bottom:10px">Serving size 1 capsule &middot; 60 servings per container</div>
<table>
<tr><td>Saffron extract (<i>Crocus sativus</i> L.) (flower)</td><td>88.5 mg</td></tr>
<tr><td colspan="2" class="small" style="border-bottom:0;padding-top:4px;font-style:italic">&dagger; Daily Value not established.</td></tr>
</table>
<p class="small" style="margin:10px 0 0">Other ingredients: rice flour, hypromellose (vegetable capsule).</p>
</div>
<div class="card">
<div class="serif" style="font-size:20px;font-weight:400;margin-bottom:4px">Evening Magnesium &middot; Sandhya</div>
<div class="small" style="margin-bottom:10px">Serving size 3 capsules &middot; 30 servings per container</div>
<table>
<tr><td>Magnesium (from 2,500 mg magnesium glycinate)</td><td>275 mg / 65% DV</td></tr>
</table>
<p class="small" style="margin:10px 0 0">Other ingredients: hypromellose (capsule), magnesium stearate, silicon dioxide, rice flour.</p>
</div>
</div>
</details>

{%- for block in faqs -%}
<details {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
<summary>{{ block.settings.question }}</summary>
<p>{{ block.settings.answer }}</p>
</details>
{%- endfor -%}
</div>
</div>
</section>

{%- comment -%} ======== CLOSING CTA (no second button, text only) ======== {%- endcomment -%}
<section class="sep bg-card">
<div class="wrap" style="text-align:center">
<h2 class="h2" style="max-width:640px;margin:0 auto 14px">{{ section.settings.cta_heading }}</h2>
<p class="lede" style="margin:0 auto 24px;max-width:520px">{{ section.settings.cta_lede }}</p>
<div style="max-width:480px;margin:0 auto">
<a href="#cs-hero-btn" class="btn" style="text-decoration:none">Back to top</a>
</div>
</div>
</section>

</main>

{%- comment -%} ======== FOOTER ======== {%- endcomment -%}
<footer class="sep">
<div class="wrap" style="padding-top:36px;padding-bottom:40px;text-align:center;display:flex;flex-direction:column;gap:18px;align-items:center">
<p class="small" style="max-width:760px;font-size:12.5px;line-height:1.6">{{ section.settings.fda_line }}</p>
<div style="display:flex;flex-direction:column;gap:4px;align-items:center;font-size:14px">
<span class="serif" style="font-weight:300">Powered by Finn <span style="color:var(--amber)">&#9829;</span></span>
<span class="serif" style="font-weight:300">फिन् द्वारा ऊर्जावान <span style="color:var(--amber)">&#9829;</span></span>
</div>
<a href="mailto:{{ section.settings.footer_email }}" class="small" style="text-decoration:none">{{ section.settings.footer_email }}</a>
<div style="display:flex;gap:16px;flex-wrap:wrap;justify-content:center">
  {%- for policy in shop.policies -%}
    {%- if policy != blank -%}
      <a href="{{ policy.url }}" class="small" style="text-decoration:none">{{ policy.title | escape }}</a>
    {%- endif -%}
  {%- endfor -%}
</div>
</div>
</footer>

{%- comment -%} Sticky mobile Reserve button {%- endcomment -%}
<div class="cs-sticky-cta" id="cs-sticky-cta">
  <div>
    <div class="cs-sticky-price">Reserve for $10</div>
    <div class="cs-sticky-sub">The rest when it ships.</div>
  </div>
  <button type="button" class="btn" id="cs-sticky-btn">Reserve now</button>
</div>

</div>

<script>
(function(){
  var form = document.getElementById('cs-product-form');
  if (!form) return;
  var radios = form.querySelectorAll('input[name="id"]');
  var holiday = {{ holiday | json }};
  var phoneBal = document.getElementById('cs-phone-bal');

  function update() {
    radios.forEach(function(r) {
      if (!r.checked) return;
      if (phoneBal) {
        phoneBal.textContent = r.dataset.balance + '.';
      }
    });
  }
  radios.forEach(function(r) { r.addEventListener('change', update); });
  update();

  /* ---- Direct-to-checkout (bypasses PreProduct cart interstitial) ---- */
  function doCheckout(triggerBtn) {
    var variantId = null;
    radios.forEach(function(r) { if (r.checked) variantId = parseInt(r.value, 10); });
    if (!variantId) return;
    var sellingPlanInput = form.querySelector('input[name="selling_plan"]');
    var spId = sellingPlanInput ? parseInt(sellingPlanInput.value, 10) : null;
    var btns = [document.getElementById('cs-hero-btn'), triggerBtn].filter(Boolean);
    btns.forEach(function(b) { b.disabled = true; b.style.opacity = '0.6'; });

    var item = { id: variantId, quantity: 1 };
    if (spId) item.selling_plan = spId;

    fetch('/cart/clear.js', { method: 'POST' })
      .then(function() {
        return fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [item] })
        });
      })
      .then(function(r) { return r.json(); })
      .then(function() {
        /* Go straight to Shopify checkout — skip /cart entirely */
        window.location.href = '/checkout';
      })
      .catch(function() {
        btns.forEach(function(b) { b.disabled = false; b.style.opacity = ''; });
      });
  }

  /* Hero form submit */
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    doCheckout(null);
  });

  /* Sticky mobile CTA button */
  var stickyBtn = document.getElementById('cs-sticky-btn');
  if (stickyBtn) {
    stickyBtn.addEventListener('click', function() { doCheckout(stickyBtn); });
  }

  /* ---- Back to Top (closing CTA) ---- */
  var backLinks = document.querySelectorAll('a[href="#cs-hero-btn"]');
  backLinks.forEach(function(a) {
    a.addEventListener('click', function(e) {
      e.preventDefault();
      var target = document.getElementById('cs-hero-btn') || document.querySelector('.cs-hero');
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        if (target.tagName === 'BUTTON') target.focus({ preventScroll: true });
      } else {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  });

  /* ---- Sticky CTA visibility (mobile only) ---- */
  var stickyCta = document.getElementById('cs-sticky-cta');
  var heroBtn = document.getElementById('cs-hero-btn');
  if (stickyCta && heroBtn) {
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        stickyCta.classList.toggle('visible', !entry.isIntersecting);
      });
    }, { threshold: 0 });
    io.observe(heroBtn);
  }
})();
</script>

