{% comment %}
  Anitya Calm Stack v3 product page.
  Changes from v2: stack radios in hero, seal band under image, benefits section,
  one add-to-cart button, mobile-first layout.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300&family=Inter:wght@400;500;600&display=swap">

<style>
/* Hide store header, footer, and cart drawer on this page */
body:has(.an-cs) .shopify-section-group-header-group,
body:has(.an-cs) .shopify-section-group-footer-group,
body:has(.an-cs) .shopify-section-group--header-group,
body:has(.an-cs) .shopify-section-group--footer-group,
body:has(.an-cs) [class*="shopify-section-group-header"],
body:has(.an-cs) [class*="shopify-section-group-footer"],
body:has(.an-cs) #shopify-section-cart-drawer { display: none !important; }

/* ---- Light tokens ---- */
.an-cs {
  --bg:#FFFFFF;--card:#FBFBFA;--ink:#1E1B16;--ink2:#6B655A;--line:#E5E5E2;
  --amber:#A0621C;--btn:#1E1B16;--btntxt:#FFFFFF;--sel:#F6F1E8;
  --bar:#A0621C;--bartxt:#FFFFFF;--cream:#EFE9DC;
  --display:Fraunces,Georgia,serif;--body:Inter,system-ui,sans-serif;
  background:var(--bg);color:var(--ink);font:16px/1.55 var(--body);
  -webkit-font-smoothing:antialiased;
}
/* ---- Dark tokens ---- */
[data-theme="dark"] .an-cs {
  --bg:#15140f;--card:#1a1813;--ink:#efe9dc;--ink2:#b8af9c;--line:#2b2820;
  --amber:#d9a86c;--btn:#efe9dc;--btntxt:#15140f;--sel:#211e17;
  --bar:#d9a86c;--bartxt:#15140f;--cream:#EFE9DC;
}

/* Base */
.an-cs *{box-sizing:border-box}
.an-cs h1,.an-cs h2,.an-cs h3{font-family:var(--display);font-weight:300;letter-spacing:-.012em;line-height:1.08;margin:0}
.an-cs p{margin:0}
.an-cs a{color:var(--ink)}.an-cs a:hover{color:var(--amber)}
.an-cs button:focus-visible,.an-cs a:focus-visible,.an-cs summary:focus-visible{outline:2px solid var(--amber);outline-offset:3px}
.an-cs img{display:block}
.an-cs fieldset{border:0;margin:0;padding:0}
.an-cs legend{padding:0}

/* Layout */
.an-cs .wrap{max-width:1200px;margin:0 auto;padding:72px 20px;box-sizing:border-box}
.an-cs .sep{border-top:1px solid var(--line)}
.an-cs .bg-card{background:var(--card)}

/* Common */
.an-cs .eyebrow{font-size:12px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--amber)}
.an-cs .h2{font-family:var(--display);font-weight:300;font-size:36px;line-height:1.1;letter-spacing:-.012em;margin:8px 0 14px}
.an-cs .lede{font-family:var(--display);font-weight:300;font-size:19px;line-height:1.4;color:var(--ink2);margin:0}
.an-cs .card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px;box-sizing:border-box}
.an-cs .btn{width:100%;min-height:58px;border:0;border-radius:14px;background:var(--btn);color:var(--btntxt);font-family:inherit;font-size:17px;font-weight:500;cursor:pointer;display:flex;align-items:center;justify-content:center}
.an-cs .btn:hover{opacity:.9}
.an-cs .small{font-size:13px;color:var(--ink2)}
.an-cs .serif{font-family:var(--display)}
.an-cs .g2{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
.an-cs .g3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.an-cs .g4{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.an-cs .ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px;font-size:15.5px;line-height:1.5}
.an-cs .ul li{display:flex;gap:10px;align-items:flex-start}
.an-cs .chk{flex-shrink:0;margin-top:2px;width:20px;height:20px}

/* Bar */
.an-cs .cs-bar{background:var(--bar);color:var(--bartxt);text-align:center;font-size:13px;font-weight:500;padding:10px 16px}

/* Header */
.an-cs .cs-header{border-bottom:1px solid var(--line)}
.an-cs .cs-header-in{max-width:1200px;margin:0 auto;padding:8px 20px;display:flex;align-items:center;justify-content:center}
.an-cs .cs-logo{height:58px;width:auto}
.an-cs .cs-logo-dark{display:none}
[data-theme="dark"] .an-cs .cs-logo-light{display:none}
[data-theme="dark"] .an-cs .cs-logo-dark{display:inline}

/* ---- HERO ---- */
.an-cs .cs-hero{max-width:1200px;margin:0 auto;padding:36px 20px 48px;display:flex;flex-wrap:wrap;gap:56px;align-items:stretch}

/* Hero image wrapper: image + seal band */
.an-cs .cs-hero-img-wrap{flex:1 1 460px;min-width:0;display:flex;flex-direction:column}
.an-cs .cs-hero-img{flex:1 1 auto;min-height:400px;position:relative;background:var(--cream);border-radius:20px 20px 0 0;overflow:hidden}
.an-cs .cs-hero-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;object-position:50% 50%}

/* Seal band (under image, not overlapping) */
.an-cs .cs-seal-band{background:var(--card);border:1px solid var(--line);border-top:0;border-radius:0 0 20px 20px;padding:16px 22px;display:flex;gap:16px;align-items:center}
.an-cs .cs-seal{width:84px;height:84px;border-radius:50%;background:#1E1B16;color:#EFE9DC;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;flex-shrink:0}
.an-cs .cs-seal-num{font-family:var(--display);font-weight:300;font-size:32px;line-height:1}
.an-cs .cs-seal-lbl{font-size:9px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;line-height:1.35;margin-top:3px}
.an-cs .cs-seal-band p{font-size:14px;line-height:1.45;color:var(--ink2);margin:0}

/* Buy box */
.an-cs .cs-buy{flex:1 1 480px;min-width:0;display:flex;flex-direction:column;gap:18px}
.an-cs .cs-hero-eyebrow{font-size:12px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--amber)}
.an-cs .cs-hero h1{font-size:46px;line-height:1.06;letter-spacing:-.012em}
.an-cs .cs-hero-sub{font-family:var(--display);font-weight:300;font-size:19px;line-height:1.4;color:var(--ink2)}

/* Stack radio group (in hero) */
.an-cs .cs-stack-legend{font-family:var(--display);font-weight:400;font-size:20px;line-height:1.3;margin-bottom:4px}
.an-cs .cs-stack-sub{display:block;font-family:var(--body);font-size:13px;font-weight:400;color:var(--ink2);margin-top:2px}
.an-cs .cs-stack-group{display:flex;flex-direction:column;gap:10px}
.an-cs .cs-stack-option{position:relative}
.an-cs .cs-stack-radio{position:absolute;opacity:0;width:0;height:0;pointer-events:none}
.an-cs .cs-stack-card{display:block;background:var(--card);border:1.5px solid var(--line);border-radius:14px;padding:14px 16px;cursor:pointer;transition:border-color .15s,background .15s}
.an-cs .cs-stack-card:hover{border-color:var(--ink2)}
.an-cs .cs-stack-radio:checked+.cs-stack-card{border-color:var(--amber);background:var(--sel)}
.an-cs .cs-stack-row{display:flex;align-items:center;gap:12px}
.an-cs .cs-stack-dot{width:20px;height:20px;border:1.5px solid var(--line);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:border-color .15s}
.an-cs .cs-stack-radio:checked+.cs-stack-card .cs-stack-dot{border-color:var(--amber)}
.an-cs .cs-stack-radio:checked+.cs-stack-card .cs-stack-dot::after{content:"";width:10px;height:10px;background:var(--amber);border-radius:50%}
.an-cs .cs-stack-name{font-family:var(--display);font-size:18px;font-weight:400;flex:1 1 auto}
.an-cs .cs-stack-price{font-size:18px;font-weight:600;white-space:nowrap}
.an-cs .cs-stack-meta{margin-left:32px;margin-top:4px;display:flex;flex-wrap:wrap;gap:6px 12px;font-size:13px;line-height:1.4}
.an-cs .cs-stack-badge{background:var(--amber);color:#fff;font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;padding:2px 8px;border-radius:999px}
.an-cs .cs-stack-save{font-weight:600;color:var(--amber)}
.an-cs .cs-stack-bonus{color:var(--amber);font-weight:500}
.an-cs .cs-stack-bal{margin-left:32px;margin-top:2px;font-size:13px;color:var(--ink2)}

/* CTA wrap */
.an-cs .cs-cta-wrap{display:flex;flex-direction:column;gap:10px}
.an-cs .cs-under-btn-desktop{text-align:center}
.an-cs .cs-under-btn-phone{display:none;text-align:center}

/* Hero benefits */
.an-cs .cs-benefits{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px;font-size:15px;line-height:1.45}
.an-cs .cs-benefits li{display:flex;gap:10px;align-items:flex-start}
.an-cs .cs-benefits b{font-weight:500}
.an-cs .cs-benefits .sub{color:var(--ink2)}

/* Guarantee line (hero) */
.an-cs .cs-guar-line{display:flex;gap:12px;align-items:flex-start;border-top:1px solid var(--line);padding-top:16px}
.an-cs .cs-guar-line svg{flex-shrink:0;margin-top:1px}
.an-cs .cs-guar-line b{font-weight:600}

/* Trust strip */
.an-cs .cs-trust{font-size:13px;color:var(--ink2)}

/* ---- BENEFITS SECTION ---- */
.an-cs .cs-ben{max-width:1200px;margin:0 auto;padding:56px 20px 48px}
.an-cs .cs-ben-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
.an-cs .cs-ben-card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px}
.an-cs .cs-ben-card h3{font-family:var(--display);font-weight:400;font-size:22px;line-height:1.2;margin:0 0 12px}
.an-cs .cs-ben-card .cs-ben-eyebrow{font-size:11px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--amber);margin-bottom:6px}
.an-cs .cs-ben-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;font-size:14.5px;line-height:1.5}
.an-cs .cs-ben-list li{display:flex;gap:8px;align-items:flex-start}
.an-cs .cs-ben-list li::before{content:"";flex-shrink:0;width:6px;height:6px;margin-top:7px;border-radius:50%;background:var(--amber)}
.an-cs .cs-ben-list b{font-weight:600}
.an-cs .cs-ben-vibe-strip{display:flex;gap:6px;margin:10px 0 8px;flex-wrap:wrap}
.an-cs .cs-ben-vibe{width:40px;height:40px;border:1px solid var(--line);border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--ink2)}
.an-cs .cs-ben-note{font-size:14px;color:var(--ink2);margin-top:16px;text-align:center;max-width:900px;margin-left:auto;margin-right:auto}
.an-cs .cs-ben-fda{font-size:12px;color:var(--ink2);margin-top:20px;text-align:center;max-width:760px;margin-left:auto;margin-right:auto;line-height:1.6}

/* ---- FAQ ---- */
.an-cs details{border-top:1px solid var(--line)}
.an-cs details:last-of-type{border-bottom:1px solid var(--line)}
.an-cs summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:20px 0;font-family:var(--display);font-weight:400;font-size:20px;line-height:1.3}
.an-cs summary::-webkit-details-marker{display:none}
.an-cs summary::after{content:"+";font-family:var(--body);font-weight:300;font-size:26px;color:var(--amber);line-height:1}
.an-cs details[open] summary::after{content:"\2212"}
.an-cs details p{margin:0 0 22px;color:var(--ink2);font-size:15.5px;line-height:1.6;max-width:760px}

/* Facts */
.an-cs table{width:100%;border-collapse:collapse;font-size:14.5px}
.an-cs td{padding:9px 0;border-bottom:1px solid var(--line);vertical-align:top}
.an-cs td:last-child{text-align:right;white-space:nowrap;padding-left:12px}

/* Founder video */
.an-cs .cs-video{background:var(--cream);border-radius:20px;aspect-ratio:4/5;max-height:520px;width:100%;overflow:hidden;position:relative}
.an-cs .cs-video iframe{position:absolute;inset:0;width:100%;height:100%;border:0}

/* ---- Sticky mobile CTA ---- */
.an-cs .cs-sticky-cta{display:none}

/* ---- Mobile ---- */
@media(max-width:860px){
  .an-cs .wrap{padding:44px 20px}
  .an-cs .h2{font-size:28px}
  .an-cs .g2,.an-cs .g3,.an-cs .g4{grid-template-columns:1fr}

  .an-cs .cs-logo{height:52px}
  .an-cs .cs-header-in{padding:4px 16px}
  .an-cs .cs-bar{font-size:12.5px;line-height:1.4;padding:9px 16px}

  /* Hero: collapse to single column, reorder */
  .an-cs .cs-hero{padding:22px 20px 40px;flex-direction:column;gap:16px}
  .an-cs .cs-buy{display:contents}
  .an-cs .cs-hero-eyebrow{order:10}
  .an-cs .cs-hero h1{order:20;font-size:32px;line-height:1.08;letter-spacing:-.01em}
  .an-cs .cs-hero-img-wrap{order:25;flex:none}
  .an-cs .cs-hero-img{min-height:0;height:250px;border-radius:18px 18px 0 0}
  .an-cs .cs-hero-photo{object-fit:cover;object-position:50% 60%}
  .an-cs .cs-seal-band{border-radius:0 0 18px 18px;padding:12px 16px;gap:12px}
  .an-cs .cs-seal{width:72px;height:72px}
  .an-cs .cs-seal-num{font-size:26px}
  .an-cs .cs-seal-lbl{font-size:8px;margin-top:2px}
  .an-cs .cs-seal-band p{font-size:13px}
  .an-cs .cs-hero-sub{order:30;font-size:17px}
  .an-cs .cs-stack-form{order:40}
  .an-cs .cs-cta-wrap{order:50}
  .an-cs .cs-guar-line{order:70}
  .an-cs .cs-benefits{order:90}
  .an-cs .cs-trust{order:100}

  /* Under-button: phone shows dynamic, desktop hidden */
  .an-cs .cs-under-btn-desktop{display:none}
  .an-cs .cs-under-btn-phone{display:block}

  /* Stack radios phone */
  .an-cs .cs-stack-card{padding:12px 14px;border-radius:12px}
  .an-cs .cs-stack-name{font-size:17px}
  .an-cs .cs-stack-price{font-size:17px}
  .an-cs .cs-stack-meta{font-size:12.5px}
  .an-cs .cs-stack-bal{font-size:12.5px}

  /* Benefits section phone */
  .an-cs .cs-ben{padding:36px 20px 32px}
  .an-cs .cs-ben-grid{grid-template-columns:1fr}
  .an-cs .cs-ben-vibe{width:40px;height:40px}

  /* Founder */
  .an-cs .cs-founder-grid{grid-template-columns:1fr !important}

  /* App ticks */
  .an-cs .cs-app-ticks{grid-template-columns:1fr !important}

  /* Facts grid inside FAQ */
  .an-cs .cs-facts-grid{grid-template-columns:1fr !important}

  /* Sticky mobile CTA — appears when hero button scrolls out of view */
  .an-cs .cs-sticky-cta{display:none;position:fixed;bottom:0;left:0;right:0;z-index:999;background:var(--bg);border-top:1px solid var(--line);padding:12px 20px;padding-bottom:max(12px,env(safe-area-inset-bottom));box-shadow:0 -2px 12px rgba(0,0,0,.08)}
  .an-cs .cs-sticky-cta.visible{display:flex;gap:10px;align-items:center}
  .an-cs .cs-sticky-cta .btn{flex:1;min-height:50px;font-size:16px}
  .an-cs .cs-sticky-cta .cs-sticky-price{font-family:var(--display);font-size:15px;font-weight:400;white-space:nowrap;color:var(--ink)}
  .an-cs .cs-sticky-cta .cs-sticky-sub{font-size:11px;color:var(--ink2);white-space:nowrap}
}

@media(prefers-reduced-motion:reduce){.an-cs *{transition:none !important}}
</style>

{%- liquid
  assign holiday = section.settings.holiday_offer
  assign ship = section.settings.ship_date
  assign tiers = section.blocks | where: "type", "tier"
  assign facts = section.blocks | where: "type", "fact"
  assign faqs = section.blocks | where: "type", "faq"
-%}

<div class="an-cs">

{%- if section.settings.bar_show -%}
<div class="cs-bar">{{ section.settings.bar_text }}</div>
{%- endif -%}

<header class="cs-header">
<div class="cs-header-in">
<a href="/" aria-label="Anitya Labs" style="display:block;line-height:0">
<img src="{{ 'anitya-lockup-light.png' | asset_url }}" alt="Anitya Labs" class="cs-logo cs-logo-light" width="180" height="58">
<img src="{{ 'anitya-lockup-dark.png' | asset_url }}" alt="Anitya Labs" class="cs-logo cs-logo-dark" width="180" height="58">
</a>
</div>
</header>

<main>

{%- comment -%} ======== HERO ======== {%- endcomment -%}
<section class="cs-hero">

{%- comment -%} Image + seal band {%- endcomment -%}
<div class="cs-hero-img-wrap">
<div class="cs-hero-img">
<picture>
<source media="(min-width:861px)" srcset="{{ 'calm-stack-hero-desktop.png' | asset_url }}">
<img src="{{ 'calm-stack-hero-phone.png' | asset_url }}" alt="Morning Saffron and Evening Magnesium, the two Calm Stack jars" loading="eager" class="cs-hero-photo" width="960" height="826">
</picture>
</div>
<div class="cs-seal-band">
<div class="cs-seal"><span class="cs-seal-num">60</span><span class="cs-seal-lbl">morning<br>guarantee</span></div>
<p>Every order is backed by the 60-morning guarantee. Full refund, no need to send it back.</p>
</div>
</div>

{%- comment -%} Buy box {%- endcomment -%}
<div class="cs-buy">
<div class="cs-hero-eyebrow">{{ section.settings.hero_eyebrow }}</div>
<h1>{% if section.settings.hero_title != blank %}{{ section.settings.hero_title }}{% else %}{{ product.title }}{% endif %}</h1>
<p class="cs-hero-sub">{{ section.settings.hero_lede }}</p>

{%- comment -%} Stack selector form {%- endcomment -%}
{%- form 'product', product, id: 'cs-product-form', class: 'cs-stack-form' -%}
{%- assign sp_id = '' -%}
{%- for group in product.selling_plan_groups -%}
  {%- for plan in group.selling_plans -%}
    {%- if sp_id == '' -%}{%- assign sp_id = plan.id -%}{%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{%- if sp_id != '' -%}
<input type="hidden" name="selling_plan" value="{{ sp_id }}">
{%- endif -%}

<fieldset class="cs-stack-group">
<legend class="cs-stack-legend">Choose your stack<span class="cs-stack-sub">Each is one Saffron jar and one Magnesium jar.</span></legend>

{%- for block in tiers -%}
  {%- assign idx = forloop.index0 -%}
  {%- assign variant = product.variants[idx] -%}
  {%- if variant -%}
  <div class="cs-stack-option">
    <input type="radio" name="id" value="{{ variant.id }}" id="cs-s-{{ block.id }}" class="cs-stack-radio" {% if forloop.index == 2 %}checked{% endif %}
      data-name="{{ variant.title }}"
      data-balance="{{ block.settings.balance }}"
      data-saving="{{ block.settings.saving }}"
      data-saving-eg="{{ block.settings.saving_evergreen }}"
      data-bonus="{{ block.settings.bonus }}"
    >
    <label for="cs-s-{{ block.id }}" class="cs-stack-card" {{ block.shopify_attributes }}>
      <div class="cs-stack-row">
        <span class="cs-stack-dot"></span>
        <span class="cs-stack-name">{{ variant.title }}</span>
        <span class="cs-stack-price">{{ variant.price | money_without_trailing_zeros }}</span>
      </div>
      <div class="cs-stack-meta">
        {%- if block.settings.badge != blank -%}<span class="cs-stack-badge">{{ block.settings.badge }}</span>{%- endif -%}
        {%- if holiday and block.settings.saving != blank -%}
          <span class="cs-stack-save">save {{ block.settings.saving }}</span>
        {%- elsif block.settings.saving_evergreen != blank -%}
          <span class="cs-stack-save">save {{ block.settings.saving_evergreen }}</span>
        {%- endif -%}
        {%- if holiday and block.settings.bonus != blank -%}
          <span class="cs-stack-bonus">{{ block.settings.bonus }}</span>
        {%- endif -%}
      </div>
      <div class="cs-stack-bal">{{ block.settings.balance }}</div>
    </label>
  </div>
  {%- endif -%}
{%- endfor -%}
</fieldset>

<p class="lede" style="margin-top:6px">{{ section.settings.tiers_quote }}</p>

<div class="cs-cta-wrap">
<button type="submit" class="btn" id="cs-hero-btn">Reserve for $10</button>
<p class="small cs-under-btn-desktop">{{ section.settings.under_button }}</p>
<p class="small cs-under-btn-phone" id="cs-phone-bal"></p>
</div>
{%- endform -%}

<div class="cs-guar-line">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0;margin-top:1px"><path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3z"/><path d="M9 12l2.2 2.2L15 10.5"/></svg>
<p style="font-size:14px;line-height:1.45"><b>{{ section.settings.guarantee_bold }}</b> {{ section.settings.guarantee_text }}</p>
</div>

<ul class="cs-benefits">
<li><svg class="chk" viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span><b>{{ section.settings.benefit_1_bold }}</b> <span class="sub">{{ section.settings.benefit_1 }}</span></span></li>
