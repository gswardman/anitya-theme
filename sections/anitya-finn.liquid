{% comment %} Site-wide closing band: Powered by Finn, matching the app footer. {% endcomment %}
<style>
  .an-finn{border-top:1px solid rgba(var(--color-foreground),.08);padding:24px 20px;text-align:center;font-size:13px;color:rgba(var(--color-foreground),.45)}
  .an-finn a{color:inherit;text-decoration:none}
  .an-finn .heart{color:#D9A35F;display:inline-block;animation:an-beat 1.6s ease-in-out infinite}
  [data-theme="light"] .an-finn .heart{color:#A0621C}
  .an-finn .en{display:block}
  .an-finn .sa{display:block;font-family:"Noto Sans Devanagari",sans-serif;font-size:12px;margin-top:4px}
  .an-finn .legal{margin-top:14px;font-size:11px;display:flex;gap:14px;flex-wrap:wrap;justify-content:center}
  .an-finn .legal a:hover{color:rgba(var(--color-foreground),.7)}
  @keyframes an-beat{0%,100%{transform:scale(1)}14%{transform:scale(1.2)}28%{transform:scale(1)}42%{transform:scale(1.12)}}
  @media(prefers-reduced-motion:reduce){.an-finn .heart{animation:none}}
</style>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400&display=swap">
<div class="an-finn">
  <div class="en">{{ section.settings.before }} {{ section.settings.after }} <span class="heart">&#9829;&#xFE0E;</span></div>
  <div class="sa" lang="sa">{{ section.settings.sanskrit }} <span class="heart">&#9829;&#xFE0E;</span></div>
  <div class="legal">
    <span>&copy; {{ 'now' | date: '%Y' }} Anitya Labs</span>
    {%- for policy in shop.policies -%}{%- if policy.body != blank -%}<a href="{{ policy.url }}">{{ policy.title }}</a>{%- endif -%}{%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Powered by Finn",
  "tag": "section",
  "enabled_on": {"groups": ["footer"]},
  "settings": [
    {"type":"text","id":"before","label":"Text before the heart","default":"Powered by"},
    {"type":"text","id":"after","label":"Text after the heart","default":"Finn"},
    {"type":"text","id":"sanskrit","label":"Sanskrit line","default":"फिन् द्वारा ऊर्जावान"}
  ]
}
{% endschema %}
