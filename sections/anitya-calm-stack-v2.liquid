<div style="background: #f6f1e8; border-radius: 14px; padding: 16px"><div class="kick" style="color: #a0621c">Dawn</div><div style="font-size: 14px; margin-top: 6px">Take one Usha capsule and tap how the morning feels.</div></div>
<div style="background: #f6eddc; border-radius: 14px; padding: 16px"><div class="kick" style="color: #a0621c">Morning</div><div style="font-size: 14px; margin-top: 6px">Write down three things you're grateful for and sit quietly for a minute.</div></div>
<div style="background: #ece5d8; border-radius: 14px; padding: 16px"><div class="kick" style="color: #a0621c">Dusk</div><div style="font-size: 14px; margin-top: 6px">Take two Sandhya capsules in the evening. No melatonin.</div></div>
</div>
</div>

<div style="display: flex; flex-direction: column; gap: 18px">
<div class="kick">Black Friday</div>
<h1 class="serif hero-h" style="font-size: 50px; line-height: 1.05; letter-spacing: -1px; margin: 0">60 mornings to see for yourself, or your money back.</h1>
<p style="font-size: 19px; margin: 0; color: #4a443a">Morning Saffron and Evening Magnesium, plus a free app where you tap how each morning feels, so you can look back and see how your mornings have been going.</p>
<div style="background: #1e1b16; color: #efe9dc; border-radius: 14px; padding: 14px 18px; font-weight: 700; font-size: 18px; line-height: 1.3">Black Friday: buy 2 or 3 stacks and get a free extra jar. <span style="color: #e9a85c">From {{ default_price }}.</span></div>

<div id="cs2-choose" style="font-weight: 600; margin-top: 6px">Choose your stack <span style="font-weight: 400; color: #6b655a">· each stack is one Saffron jar and one Magnesium jar</span></div>
{%- form 'product', product, id: 'cs2-product-form', class: 'cs2-form', novalidate: 'novalidate' -%}
<div class="cs2-tiers" role="radiogroup" aria-labelledby="cs2-choose" style="display: flex; flex-direction: column; gap: 10px">
{%- for block in tiers -%}
{%- assign variant = product.variants[forloop.index0] -%}
{%- if variant -%}
<input type="radio" name="id" value="{{ variant.id }}" id="cs2-tier-{{ block.id }}" class="cs2-radio"{% if variant.id == default_variant.id %} checked{% endif %} data-name="{{ variant.title | escape }}" data-price="{{ variant.price | money_without_trailing_zeros | strip_html | escape }}" data-sticky="{{ block.settings.sticky_detail | escape }}">
<label class="tile" for="cs2-tier-{{ block.id }}" {{ block.shopify_attributes }}>
<div>
<div style="font-weight: 600; font-size: 17px">{{ variant.title }}</div>
{%- if block.settings.detail != blank %}
<div style="font-size: 14px; color: #6b655a">{{ block.settings.detail }}</div>
{%- endif -%}
{%- if block.settings.bonus != blank %}
<div style="font-size: 14px; color: #a0621c; font-weight: 600">{{ block.settings.bonus }}</div>
{%- endif -%}
{%- if block.settings.note != blank %}
<div style="font-size: 14px; font-style: italic">{{ block.settings.note }}</div>
{%- endif %}
</div>
<div style="text-align: right"><div class="serif" style="font-size: 26px">{{ variant.price | money_without_trailing_zeros }}</div>{% if block.settings.per_morning != blank %}<div style="font-size: 13px; color: #6b655a">{{ block.settings.per_morning }}</div>{% endif %}</div>
</label>
{%- endif -%}
{%- endfor %}
</div>

<button type="submit" class="btn" id="cs2-hero-btn">Add <span data-cs2-name>{{ default_variant.title }}</span> to cart · <span data-cs2-price>{{ default_price }}</span></button>
{%- endform %}
<div style="text-align: center; font-size: 14px; color: #4a443a; margin-top: -6px"><b>You pay <span data-cs2-price>{{ default_price }}</span> today, and that's the whole price.</b> No subscription, no code. Ships within one business day, free US shipping.</div>
<div style="font-size: 14px; color: #4a443a">60-morning guarantee: if it's not for you, we refund you in full and you keep the jars.</div>

<div style="display: flex; flex-direction: column; gap: 8px; border-top: 1px solid #e4ded3; padding-top: 14px; font-size: 15px">
