{% comment %}
  Anitya Calm Stack v2 product page: buy now at full price, no reservation.
  Built from briefs/calm-stack-v2/mockup-clean.dc.html.
  The product form sends the variant id only. No selling plan anywhere in this file.
  All CSS is scoped under .an-cs2.
{% endcomment %}

{%- liquid
  assign tiers = section.blocks | where: 'type', 'tier'
  assign default_variant = product.variants[1] | default: product.selected_or_first_available_variant
  assign default_price = default_variant.price | money_without_trailing_zeros
  assign weather_paths = 'M7 14h10a3.5 3.5 0 0 0 .4-7A5 5 0 0 0 8 6.5 3.8 3.8 0 0 0 7 14zM9 17l-1 3M12.5 17l-1 3M16 17l-1 3|M7 17h10a3.5 3.5 0 0 0 .4-7A5 5 0 0 0 8 9.5 3.8 3.8 0 0 0 7 17z|M9 5v1M5 9h1M6.2 6.2l.7.7M12 9a3 3 0 1 0-5.8 1M9 19h8a3 3 0 0 0 .3-6 4.2 4.2 0 0 0-7.9.6A2.8 2.8 0 0 0 9 19z|M4 20h16M7 20a5 5 0 0 1 10 0M12 9v2M6 12l1.4 1.4M18 12l-1.4 1.4|M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM12 2v2M12 20v2M2 12h2M20 12h2|M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zM12 1v3M12 20v3M1 12h3M20 12h3M4.2 4.2l2 2M17.8 17.8l2 2M4.2 19.8l2-2M17.8 6.2l2-2' | split: '|'
  assign bar_vals = '2,3,3,2,4,3,3,4,3,4,4,3,5,4,4,5,4,5,5,4,5' | split: ','
-%}

{% # theme-check-disable RemoteAsset %}
{%- comment -%} Google Fonts, loaded the same way as in v3 and layout/theme.liquid {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300;1,9..144,400&family=Inter:wght@400;500;600;700&display=swap">
{% # theme-check-enable RemoteAsset %}

<style>
/* This page has no store menu. Hide the theme's whole header group (header and any
   announcement bar in it). This rule only exists on pages that render this section. */
.shopify-section-group-header-group,
.shopify-section-group--header-group,
[class*="shopify-section-group-header"]{display:none !important}

/* Keep theme-wide rules out of this page */
.an-cs2{letter-spacing:normal;text-align:left;word-break:normal;text-transform:none}
.an-cs2 h1,.an-cs2 h2{font-style:normal;letter-spacing:normal;color:inherit;line-height:inherit;word-break:normal}
.an-cs2 p{color:inherit;letter-spacing:normal}
.an-cs2 div:empty{display:block}
.an-cs2 img{max-width:none;border:0}
.an-cs2 b{font-weight:700}

/* From the mockup */
.an-cs2 a{color:#a0621c}
.an-cs2 a:hover{color:#7a4a15}
.an-cs2 .wrap{max-width:1160px;margin:0 auto;padding:0 24px;box-sizing:border-box}
.an-cs2 .serif{font-family:"Fraunces",Georgia,serif;font-weight:300}
.an-cs2 .kick{font-size:12px;font-weight:500;letter-spacing:1.7px;text-transform:uppercase;color:#6b655a}
.an-cs2 .dark .kick{color:#a0621c}
.an-cs2 .tile{border:1px solid #d9d9d5;border-radius:14px;padding:16px 18px;display:flex;justify-content:space-between;gap:12px;background:#ffffff}
.an-cs2 .card{background:#ffffff;border:1px solid #e4ded3;border-radius:14px;padding:22px}
.an-cs2 .dark .card{background:#1f1d17;border-color:#e4ded3}
.an-cs2 .btn{display:block;text-align:center;background:#1e1b16;color:#efe9dc;text-decoration:none;font-weight:600;font-size:16px;padding:17px 20px;border-radius:14px}
.an-cs2 .btn:hover{color:#fff;background:#000}
.an-cs2 .dark .btn{background:#efe9dc;color:#1e1b16}
.an-cs2 .dark .btn:hover{background:#fff;color:#1e1b16}
.an-cs2 .grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:56px;align-items:start}
.an-cs2 .grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.an-cs2 .grid4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
.an-cs2 .mob{display:none}

/* Buy form: radios behind the mockup's tiles, and the button as a real button */
.an-cs2 .cs2-form{display:flex;flex-direction:column;gap:18px;margin:0}
.an-cs2 .cs2-close-form,.an-cs2 .cs2-app-form{margin:0}
.an-cs2 .cs2-tiers{position:relative}
.an-cs2 .cs2-radio{position:absolute;width:1px;height:1px;margin:0;opacity:0;pointer-events:none}
.an-cs2 label.tile{cursor:pointer;font:inherit;color:inherit;letter-spacing:normal;margin:0}
.an-cs2 .cs2-radio:checked + .tile{border:2px solid #1e1b16;background:#f6f1e8}
.an-cs2 .cs2-radio:focus-visible + .tile{outline:2px solid #a0621c;outline-offset:2px}
.an-cs2 button.btn{width:100%;box-sizing:border-box;border:0;margin:0;font-family:inherit;line-height:inherit;letter-spacing:normal;cursor:pointer;-webkit-appearance:none;appearance:none}
.an-cs2 button.btn[disabled]{opacity:.6;cursor:default}
.an-cs2 .cs2-app-form{background:#ffffff;border:1px solid #e4ded3;border-radius:14px;padding:18px;display:flex;flex-direction:column;gap:10px;margin-top:6px}

/* Add-to-cart bar, phones only, shown once the hero button has scrolled out of view */
.an-cs2 .cs2-sticky{display:none}

@media (max-width:860px){
  .an-cs2 .mob{display:block !important}
  .an-cs2 .desk{display:none !important}
  .an-cs2 .grid2{grid-template-columns:minmax(0,1fr);gap:28px}
  .an-cs2 .grid3,.an-cs2 .grid4{grid-template-columns:minmax(0,1fr)}
  .an-cs2 .hero-h{font-size:38px !important}
  .an-cs2 .sec-h{font-size:32px !important}
  .an-cs2 .hero-stage{height:340px !important;padding-bottom:18px !important;gap:16px !important}
  .an-cs2 .hero-jar,.an-cs2 .hero-jar2{height:215px !important}
  .an-cs2 .cs2-sticky{position:fixed;left:0;right:0;bottom:0;z-index:999;background:#1e1b16;color:#efe9dc;border-top:1px solid #e4ded3;padding-bottom:env(safe-area-inset-bottom)}
  .an-cs2 .cs2-sticky.visible{display:block}
  .an-cs2 .cs2-sticky button.btn{width:auto}
}
</style>

<div class="an-cs2" style="font-family: Inter, system-ui, sans-serif; color: #1e1b16; background: #ffffff; line-height: 1.5; font-size: 16px">

{%- comment -%} Logo row: not a link, no nav, no cart icon {%- endcomment -%}
<div style="border-bottom: 1px solid #e4ded3; background: #ffffff">
<div class="wrap" style="display: flex; align-items: center; justify-content: center; gap: 10px; padding-top: 16px; padding-bottom: 16px; color: #1e1b16"><svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="none" stroke="#1e1b16" stroke-width="1.4"></circle><path d="M12 17s-5-3.1-5-6.4A2.7 2.7 0 0 1 12 9a2.7 2.7 0 0 1 5 1.6C17 13.9 12 17 12 17z" fill="#1e1b16"></path></svg><span class="serif" style="font-size: 20px">Anitya Labs</span></div>
</div>
<div style="background: #a0621c; color: #ffffff; text-align: center; font-size: 14px; font-weight: 500; padding: 11px 16px">
<b style="color: #ffffff">Black Friday:</b> a free extra jar with The Practice or The Season · until 24 Dec · no code needed · ships within one business day
</div>

<div class="wrap" style="padding-top: 48px; padding-bottom: 64px">
<div class="grid2">
<div style="display: flex; flex-direction: column; gap: 16px">
<div style="background: #f6f1e8; border-radius: 20px; height: 520px; display: flex; align-items: flex-end; justify-content: center; gap: 28px; padding-bottom: 44px; box-sizing: border-box; position: relative" class="hero-stage">
<img class="hero-jar" src="{{ 'calm-stack-saffron-1.png' | asset_url }}" width="530" height="1000" loading="eager" alt="Morning Saffron jar, Usha, dawn" style="height: 370px; width: auto; filter: drop-shadow(0 12px 14px rgba(0,0,0,.14))">
<img class="hero-jar2" src="{{ 'calm-stack-magnesium-1.png' | asset_url }}" width="530" height="1000" loading="eager" alt="Evening Magnesium jar, Sandhya, dusk" style="height: 370px; width: auto; filter: drop-shadow(0 12px 14px rgba(0,0,0,.14))">
<div style="position: absolute; z-index: 3; top: 18px; left: 18px; background: #1e1b16; color: #efe9dc; border-radius: 50%; width: 92px; height: 92px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; font-size: 10px; font-weight: 700; letter-spacing: 1px; line-height: 1.15">
<span class="serif" style="font-size: 30px; font-weight: 400; letter-spacing: 0">60</span>MORNING<br>GUARANTEE</div>
</div>
<div style="display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px">
<div style="background: #f6f1e8; border-radius: 12px; height: 120px; display: flex; align-items: center; justify-content: center; overflow: hidden"><img src="{{ 'calm-stack-saffron-2.png' | asset_url }}" width="530" height="1000" loading="lazy" alt="Morning Saffron, Supplement Facts" style="height: 104px; width: auto"></div>
<div style="background: #f6f1e8; border-radius: 12px; height: 120px; display: flex; align-items: center; justify-content: center; overflow: hidden"><img src="{{ 'calm-stack-magnesium-2.png' | asset_url }}" width="530" height="1000" loading="lazy" alt="Evening Magnesium, Supplement Facts" style="height: 104px; width: auto"></div>
<div style="background: #f6f1e8; border-radius: 12px; height: 120px; display: flex; align-items: center; justify-content: center; overflow: hidden"><img src="{{ 'calm-stack-saffron-3.png' | asset_url }}" width="530" height="1000" loading="lazy" alt="Morning Saffron, suggested use" style="height: 104px; width: auto"></div>
<div style="background: #f6f1e8; border-radius: 12px; height: 120px; display: flex; align-items: center; justify-content: center; overflow: hidden"><img src="{{ 'calm-stack-magnesium-3.png' | asset_url }}" width="530" height="1000" loading="lazy" alt="Evening Magnesium, suggested use" style="height: 104px; width: auto"></div>
</div>
<div class="card desk" style="display: flex; flex-direction: column; gap: 4px; margin-top: 8px">
<div class="kick" style="margin-bottom: 8px">In every stack</div>
<div style="display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; border-top: 1px solid #ece7de"><b>Morning Saffron</b><span style="color: #6b655a; text-align: right">60 capsules, one each morning</span></div>
<div style="display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; border-top: 1px solid #ece7de"><b>Evening Magnesium</b><span style="color: #6b655a; text-align: right">90 capsules, two each evening</span></div>
<div style="display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; border-top: 1px solid #ece7de"><b>The Anitya app</b><span style="color: #6b655a; text-align: right">Free for life</span></div>
