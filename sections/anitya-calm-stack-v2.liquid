<div class="wrap" style="display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 12px; padding-bottom: 12px">
<div style="font-size: 15px"><b data-cs2-name>{{ default_variant.title }}</b> · <span data-cs2-sticky>{{ tiers[1].settings.sticky_detail }}</span> · <b style="color: #e9a85c" data-cs2-price>{{ default_price }}</b></div>
<button type="button" class="btn" id="cs2-sticky-btn" style="padding: 12px 26px; font-size: 16px; white-space: nowrap; flex-shrink: 0">Add to cart</button>
</div>
</div>

</div>

<script>
(function(){
  var form = document.getElementById('cs2-product-form');
  if (!form) return;
  var root = form.closest('.an-cs2') || document;
  var radios = form.querySelectorAll('input[name="id"]');
  var heroBtn = document.getElementById('cs2-hero-btn');
  var closeForm = document.getElementById('cs2-close-form');
  var closeBtn = document.getElementById('cs2-close-btn');
  var stickyBtn = document.getElementById('cs2-sticky-btn');

  function setText(attr, value) {
    root.querySelectorAll('[' + attr + ']').forEach(function(el) { el.textContent = value; });
  }

  /* Button text, price line and phone bar follow the selected tier */
  function update() {
    radios.forEach(function(r) {
      if (!r.checked) return;
      setText('data-cs2-name', r.dataset.name);
      setText('data-cs2-price', r.dataset.price);
      setText('data-cs2-sticky', r.dataset.sticky);
    });
  }
  radios.forEach(function(r) { r.addEventListener('change', update); });
  update();

  function selectedId() {
    var id = null;
    radios.forEach(function(r) { if (r.checked) id = parseInt(r.value, 10); });
    return id;
  }

  /* ---- Direct-to-checkout: variant id and quantity only ---- */
  function doCheckout(variantId, fallbackForm) {
    if (!variantId) return;
    var btns = [heroBtn, closeBtn, stickyBtn].filter(Boolean);
    btns.forEach(function(b) { b.disabled = true; });

    var item = { id: variantId, quantity: 1 };

    fetch('/cart/clear.js', { method: 'POST' })
      .then(function() {
        return fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [item] })
        });
      })
      .then(function(r) {
        if (!r.ok) throw new Error('cart add failed');
        return r.json();
      })
      .then(function() {
        /* Go straight to Shopify checkout — skip /cart entirely */
        window.location.href = '/checkout';
      })
      .catch(function() {
        btns.forEach(function(b) { b.disabled = false; });
        /* Plain form post, so Shopify can show its own error */
        if (fallbackForm) fallbackForm.submit();
      });
  }

  /* Hero form submit */
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    doCheckout(selectedId(), form);
  });

  /* Closing button: adds the tier named on the button */
  if (closeForm) {
    closeForm.addEventListener('submit', function(e) {
      e.preventDefault();
      var input = closeForm.querySelector('input[name="id"]');
      doCheckout(input ? parseInt(input.value, 10) : null, closeForm);
    });
  }

  /* Phone bar button: same submit as the hero button */
  if (stickyBtn) {
    stickyBtn.addEventListener('click', function() { doCheckout(selectedId(), form); });
  }

  /* ---- Phone bar visibility: once the hero button has scrolled out of view ---- */
  var stickyBar = document.getElementById('cs2-sticky');
  if (stickyBar && heroBtn && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        stickyBar.classList.toggle('visible', !entry.isIntersecting && entry.boundingClientRect.top < 0);
      });
    }, { threshold: 0 });
    io.observe(heroBtn);
  }
})();
</script>

