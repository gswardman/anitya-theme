<script>
(function(){
  var form = document.getElementById('cs2-product-form');
  if (!form) return;
  var root = form.closest('.an-cs2') || document;
  var radios = form.querySelectorAll('input[name="id"]');
  var heroBtn = document.getElementById('cs2-hero-btn');
  var closeForm = document.getElementById('cs2-close-form');
  var closeBtn = document.getElementById('cs2-close-btn');
  var stickyBtn = document.getElementById('cs2-sticky-btn');
  var addonCb = document.getElementById('cs2-addon-cb');
  var addonPriceCents = addonCb ? parseInt(addonCb.dataset.addonPrice || '0', 10) : 0;
  var addonId = addonCb ? parseInt(addonCb.dataset.addonId || '0', 10) : 0;

  function setText(attr, value) {
    root.querySelectorAll('[' + attr + ']').forEach(function(el) { el.textContent = value; });
  }

  function formatMoney(cents) {
    var d = cents / 100;
    return '$' + (d % 1 === 0 ? d : d.toFixed(2));
  }

  function selectedPriceCents() {
    var cents = 0;
    radios.forEach(function(r) { if (r.checked) cents = parseInt(r.dataset.priceCents, 10); });
    return cents;
  }

  function totalCents() {
    var t = selectedPriceCents();
    if (addonCb && addonCb.checked) t += addonPriceCents;
    return t;
  }

  /* Button text, price line and phone bar follow the selected tier + addon */
  function update() {
    radios.forEach(function(r) {
      if (!r.checked) return;
      setText('data-cs2-name', r.dataset.name);
    });
    var total = formatMoney(totalCents());
    setText('data-cs2-total', total);
    /* Closing button always shows the default tier total (buy 2 get 1 free) */
  }
  radios.forEach(function(r) { r.addEventListener('change', update); });
  if (addonCb) addonCb.addEventListener('change', update);
  update();

  function selectedId() {
    var id = null;
    radios.forEach(function(r) { if (r.checked) id = parseInt(r.value, 10); });
    return id;
  }

  /* ---- Direct-to-checkout: variant id(s) and quantity only ---- */
  function doCheckout(variantId, includeAddon, fallbackForm) {
    if (!variantId) return;
    var btns = [heroBtn, closeBtn, stickyBtn].filter(Boolean);
    btns.forEach(function(b) { b.disabled = true; });

    var items = [{ id: variantId, quantity: 1 }];
    if (includeAddon && addonCb && addonCb.checked && addonId) {
      items.push({ id: addonId, quantity: 1 });
    }

    fetch('/cart/clear.js', { method: 'POST' })
      .then(function() {
        return fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: items })
        });
      })
      .then(function(r) {
        if (!r.ok) throw new Error('cart add failed');
        return r.json();
      })
      .then(function() {
        window.location.href = '/checkout';
      })
      .catch(function() {
        btns.forEach(function(b) { b.disabled = false; });
        if (fallbackForm) fallbackForm.submit();
      });
  }

  /* Hero form submit */
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    doCheckout(selectedId(), true, form);
  });

  /* Closing button: adds the default tier (buy 2 get 1 free), no addon */
  if (closeForm) {
    closeForm.addEventListener('submit', function(e) {
      e.preventDefault();
      var input = closeForm.querySelector('input[name="id"]');
      doCheckout(input ? parseInt(input.value, 10) : null, false, closeForm);
    });
  }

  /* Phone bar button: same submit as the hero button */
  if (stickyBtn) {
    stickyBtn.addEventListener('click', function() { doCheckout(selectedId(), true, form); });
  }

  /* ---- Phone bar visibility: once the hero button has scrolled out of view ---- */
  var stickyBar = document.getElementById('cs2-sticky');
  if (stickyBar && heroBtn && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        stickyBar.classList.toggle('visible', !entry.isIntersecting && entry.boundingClientRect.top < 0);
      });
    }, { threshold: 0 });
    io.observe(heroBtn);
  }
})();
</script>

