{% comment %}
  Anitya Calm Stack v2: saffron-first offer, 27 Nov 2026.
  Morning Saffron leads. Evening Magnesium is an optional add-on.
  The product form sends the saffron variant id; the add-on checkbox adds the
  magnesium variant as a second cart item. No selling plan anywhere.
  All CSS is scoped under .an-cs2.
{% endcomment %}

{%- liquid
  assign tiers = section.blocks | where: 'type', 'tier'
  comment
    Look up each tier's variant by ID (from the block setting) instead of by
    position, because the old stack variants still sit at indices 0-2.
  endcomment
  assign default_tier = tiers[1] | default: tiers[0]
  assign default_vid = default_tier.settings.variant_id | plus: 0
  assign default_variant = product.selected_or_first_available_variant
  for v in product.variants
    if v.id == default_vid
      assign default_variant = v
      break
    endif
  endfor
  assign default_price = default_variant.price | money_without_trailing_zeros
  assign addon_id = section.settings.addon_variant_id
  assign addon_price_cents = section.settings.addon_price | default: 2500
  assign addon_price_dollars = addon_price_cents | divided_by: 100
  if addon_id == blank
    assign show_addon = false
  else
    assign show_addon = true
  endif
  assign weather_paths = 'M7 14h10a3.5 3.5 0 0 0 .4-7A5 5 0 0 0 8 6.5 3.8 3.8 0 0 0 7 14zM9 17l-1 3M12.5 17l-1 3M16 17l-1 3|M7 17h10a3.5 3.5 0 0 0 .4-7A5 5 0 0 0 8 9.5 3.8 3.8 0 0 0 7 17z|M9 5v1M5 9h1M6.2 6.2l.7.7M12 9a3 3 0 1 0-5.8 1M9 19h8a3 3 0 0 0 .3-6 4.2 4.2 0 0 0-7.9.6A2.8 2.8 0 0 0 9 19z|M4 20h16M7 20a5 5 0 0 1 10 0M12 9v2M6 12l1.4 1.4M18 12l-1.4 1.4|M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM12 2v2M12 20v2M2 12h2M20 12h2|M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zM12 1v3M12 20v3M1 12h3M20 12h3M4.2 4.2l2 2M17.8 17.8l2 2M4.2 19.8l2-2M17.8 6.2l2-2' | split: '|'
-%}

