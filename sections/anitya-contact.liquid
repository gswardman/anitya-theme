{% comment %}
  Anitya Labs footer contact: a small "Say hello" band on every page, above the
  Powered by Finn line. Replaces the standalone Contact page form. Uses
  Shopify's contact form, so messages arrive in the store's customer email.
  Copy is editable in the theme editor. Colours follow the theme toggle
  (Dawn rgb variables + the Anitya amber).
{% endcomment %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;1,9..144,300&family=Inter:wght@400;500&display=swap">
<style>
  .an-say{--amber:#D9A35F;border-top:1px solid rgba(var(--color-foreground),.08);padding:56px 20px 48px;color:rgb(var(--color-foreground))}
  [data-theme="light"] .an-say{--amber:#A0621C}
  .an-say *{box-sizing:border-box}
  .an-say .wrap{max-width:1040px;margin:0 auto;display:grid;grid-template-columns:.9fr 1.1fr;gap:48px;align-items:start}
  .an-say h2{margin:0 0 12px;font-family:Fraunces,Georgia,serif;font-weight:300;font-size:clamp(30px,4vw,42px);line-height:1.1;letter-spacing:-.01em}
  .an-say p{margin:0;font-family:Fraunces,Georgia,serif;font-weight:300;font-size:19px;line-height:1.45;color:rgba(var(--color-foreground),.72);max-width:30em}
  .an-say .mail{display:block;margin-top:14px;font:14px Inter,system-ui,sans-serif;color:rgba(var(--color-foreground),.55);text-decoration:none}
  .an-say .mail:hover{color:var(--amber)}
  .an-say form{display:grid;gap:10px;max-width:560px;font-family:Inter,system-ui,sans-serif}
  .an-say input,.an-say textarea{width:100%;border-radius:14px;border:1px solid rgba(var(--color-foreground),.16);background:rgba(var(--color-foreground),.05);color:rgb(var(--color-foreground));padding:13px 16px;font:15px/1.4 Inter,system-ui,sans-serif;resize:vertical}
  .an-say input::placeholder,.an-say textarea::placeholder{color:rgba(var(--color-foreground),.4)}
  .an-say input:focus-visible,.an-say textarea:focus-visible,.an-say button:focus-visible{outline:2px solid var(--amber);outline-offset:2px}
  .an-say .row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .an-say .send{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
  .an-say button{min-height:46px;padding:0 22px;border-radius:14px;border:0;background:rgb(var(--color-foreground));color:rgb(var(--color-background));font:500 15px Inter,system-ui,sans-serif;cursor:pointer}
  .an-say button:hover{background:var(--amber);color:#15140f}
  .an-say .fine{font-size:13px;color:rgba(var(--color-foreground),.45)}
  .an-say .ok{font-family:Fraunces,Georgia,serif;font-style:italic;font-size:19px;color:var(--amber)}
  .an-say .err{font:14px Inter,system-ui,sans-serif;color:#e0a28a}
  .an-say .err a{color:inherit}
  @media(max-width:760px){.an-say{padding:40px 20px 36px}.an-say .wrap{grid-template-columns:1fr;gap:24px}.an-say .row{grid-template-columns:1fr}}
</style>
<div class="an-say" id="say-hello">
  <div class="wrap">
    <div>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.copy }}</p>
      {%- if section.settings.email != blank -%}
        <a class="mail" href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
      {%- endif -%}
    </div>
    {%- form 'contact', id: 'ContactForm' -%}
      {%- if form.posted_successfully? -%}
        <div class="ok" tabindex="-1" autofocus>{{ section.settings.success }}</div>
      {%- else -%}
        {%- if form.errors -%}
          <div class="err" role="alert" tabindex="-1" autofocus>
            <a href="#ContactForm-email">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</a>
          </div>
        {%- endif -%}
        <div class="row">
          <input type="text" id="ContactForm-name" name="contact[{{ 'templates.contact.form.name' | t }}]" autocomplete="name"
            placeholder="{{ section.settings.name_placeholder }}"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
          <input type="email" id="ContactForm-email" name="contact[email]" autocomplete="email" spellcheck="false" autocapitalize="off" required aria-required="true"
            placeholder="{{ section.settings.email_placeholder }}"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}>
        </div>
        <textarea id="ContactForm-body" name="contact[{{ 'templates.contact.form.comment' | t }}]" rows="3" required aria-required="true"
          placeholder="{{ section.settings.message_placeholder }}">{{ form.body }}</textarea>
        <div class="send">
          <button type="submit">{{ section.settings.button }}</button>
          <span class="fine">{{ section.settings.fine }}</span>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>
{% schema %}
{
  "name": "Say hello (contact)",
  "tag": "section",
  "enabled_on": {"groups": ["footer"]},
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Say hello."},
    {"type":"textarea","id":"copy","label":"Copy","default":"A question, an idea, something that broke in the app. Write to me, I read everything."},
    {"type":"text","id":"email","label":"Email shown under the copy (optional)"},
    {"type":"text","id":"name_placeholder","label":"Name placeholder","default":"Your name"},
    {"type":"text","id":"email_placeholder","label":"Email placeholder","default":"your@email.com"},
    {"type":"text","id":"message_placeholder","label":"Message placeholder","default":"What's on your mind?"},
    {"type":"text","id":"button","label":"Button","default":"Send"},
    {"type":"text","id":"fine","label":"Small print next to the button","default":"No list, no newsletter. Just a reply."},
    {"type":"text","id":"success","label":"After sending","default":"Got it. I'll write back."}
  ]
}
{% endschema %}
