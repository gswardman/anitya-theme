{% comment %}
  Anitya Calm Stack v2 product page. One section, all copy editable.
  Wrapper .an-cs, all CSS scoped. Light default, dark via html[data-theme="dark"].
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300&family=Inter:wght@400;500;600&display=swap">

<style>
/* Hide store header and footer on this page */
body:has(.an-cs) .shopify-section-group-header-group,
body:has(.an-cs) .shopify-section-group-footer-group,
body:has(.an-cs) .shopify-section-group--header-group,
body:has(.an-cs) .shopify-section-group--footer-group { display: none !important; }

/* ---- Light tokens ---- */
.an-cs {
  --bg:#FFFFFF;--card:#FBFBFA;--ink:#1E1B16;--ink2:#6B655A;--line:#E5E5E2;
  --amber:#A0621C;--btn:#1E1B16;--btntxt:#FFFFFF;--sel:#F6F1E8;
  --bar:#A0621C;--bartxt:#FFFFFF;--cream:#EFE9DC;
  --display:Fraunces,Georgia,serif;--body:Inter,system-ui,sans-serif;
  background:var(--bg);color:var(--ink);font:16px/1.55 var(--body);
  -webkit-font-smoothing:antialiased;
}
/* ---- Dark tokens ---- */
[data-theme="dark"] .an-cs {
  --bg:#15140f;--card:#1a1813;--ink:#efe9dc;--ink2:#b8af9c;--line:#2b2820;
  --amber:#d9a86c;--btn:#efe9dc;--btntxt:#15140f;--sel:#211e17;
  --bar:#d9a86c;--bartxt:#15140f;--cream:#EFE9DC;
}

/* Base */
.an-cs *{box-sizing:border-box}
.an-cs h1,.an-cs h2,.an-cs h3{font-family:var(--display);font-weight:300;letter-spacing:-.012em;line-height:1.08;margin:0}
.an-cs p{margin:0}
.an-cs a{color:var(--ink)}.an-cs a:hover{color:var(--amber)}
.an-cs button:focus-visible,.an-cs a:focus-visible,.an-cs summary:focus-visible{outline:2px solid var(--amber);outline-offset:3px}
.an-cs img{display:block}

/* Layout */
.an-cs .wrap{max-width:1200px;margin:0 auto;padding:72px 20px;box-sizing:border-box}
.an-cs .sep{border-top:1px solid var(--line)}
.an-cs .bg-card{background:var(--card)}

/* Common */
.an-cs .eyebrow{font-size:12px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--amber)}
.an-cs .h2{font-family:var(--display);font-weight:300;font-size:36px;line-height:1.1;letter-spacing:-.012em;margin:8px 0 14px}
.an-cs .lede{font-family:var(--display);font-weight:300;font-size:19px;line-height:1.4;color:var(--ink2);margin:0}
.an-cs .card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px;box-sizing:border-box}
.an-cs .btn{width:100%;min-height:58px;border:0;border-radius:14px;background:var(--btn);color:var(--btntxt);font-family:inherit;font-size:17px;font-weight:500;cursor:pointer;display:flex;align-items:center;justify-content:center}
.an-cs .btn:hover{opacity:.9}
.an-cs .small{font-size:13px;color:var(--ink2)}
.an-cs .serif{font-family:var(--display)}
.an-cs .g2{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
.an-cs .g3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.an-cs .g4{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.an-cs .ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px;font-size:15.5px;line-height:1.5}
.an-cs .ul li{display:flex;gap:10px;align-items:flex-start}
.an-cs .chk{flex-shrink:0;margin-top:2px;width:20px;height:20px}

/* Bar */
.an-cs .cs-bar{background:var(--bar);color:var(--bartxt);text-align:center;font-size:13px;font-weight:500;padding:10px 16px}

/* Header */
.an-cs .cs-header{border-bottom:1px solid var(--line)}
.an-cs .cs-header-in{max-width:1200px;margin:0 auto;padding:8px 20px;display:flex;align-items:center;justify-content:center}
.an-cs .cs-logo{height:58px;width:auto}
.an-cs .cs-logo-dark{display:none}
[data-theme="dark"] .an-cs .cs-logo-light{display:none}
[data-theme="dark"] .an-cs .cs-logo-dark{display:inline}

/* ---- HERO ---- */
.an-cs .cs-hero{max-width:1200px;margin:0 auto;padding:36px 20px 48px;display:flex;flex-wrap:wrap;gap:56px;align-items:stretch}
.an-cs .cs-hero-img{flex:1 1 460px;min-width:0;min-height:560px;position:relative;background:var(--cream);border-radius:20px;overflow:hidden}
.an-cs .cs-hero-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;object-position:50% 50%}
.an-cs .cs-seal{position:absolute;left:22px;bottom:22px;width:112px;height:112px;border-radius:50%;background:#1E1B16;color:#EFE9DC;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
.an-cs .cs-seal-num{font-family:var(--display);font-weight:300;font-size:38px;line-height:1}
.an-cs .cs-seal-lbl{font-size:9.5px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;line-height:1.35;margin-top:4px}
.an-cs .cs-buy{flex:1 1 480px;min-width:0;display:flex;flex-direction:column;gap:18px}
.an-cs .cs-hero-eyebrow{font-size:12px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--amber)}
.an-cs .cs-hero h1{font-size:46px;line-height:1.06;letter-spacing:-.012em}
.an-cs .cs-hero-sub{font-family:var(--display);font-weight:300;font-size:19px;line-height:1.4;color:var(--ink2)}

/* Benefits */
.an-cs .cs-benefits{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px;font-size:15px;line-height:1.45}
.an-cs .cs-benefits li{display:flex;gap:10px;align-items:flex-start}
.an-cs .cs-benefits b{font-weight:500}
.an-cs .cs-benefits .sub{color:var(--ink2)}

/* App card (hero) */
.an-cs .cs-app-card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px 16px;display:flex;flex-direction:column;gap:12px}
.an-cs .cs-vibe-strip{display:flex;gap:8px}
.an-cs .cs-vibe-icon{width:42px;height:42px;border:1px solid var(--line);border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--ink2)}
.an-cs .cs-vibe-icon.amber{color:var(--amber)}
.an-cs .cs-vibe-icon.sel{border:1.5px solid var(--amber);color:var(--amber)}

/* Offer card (hero) */
.an-cs .cs-offer{background:var(--card);border:1.5px solid var(--amber);border-radius:16px;padding:14px 18px;display:flex;flex-direction:column;gap:5px}
.an-cs .cs-offer-top{display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap}
.an-cs .cs-offer-name{font-family:var(--display);font-size:20px;font-weight:400}
.an-cs .cs-offer-detail{font-size:13px;color:var(--ink2)}
.an-cs .cs-offer-price{font-size:22px;font-weight:500}
.an-cs .cs-offer-save{font-size:13px;font-weight:600;color:var(--amber)}
.an-cs .cs-offer-bonus{font-size:13px;color:var(--amber);font-weight:500}
.an-cs .cs-offer-bal{font-size:13px;color:var(--ink2)}

/* CTA wrap */
.an-cs .cs-cta-wrap{display:flex;flex-direction:column;gap:10px}

/* Guarantee line (hero) */
.an-cs .cs-guar-line{display:flex;gap:12px;align-items:flex-start;border-top:1px solid var(--line);padding-top:16px}
.an-cs .cs-guar-line svg{flex-shrink:0;margin-top:1px}
.an-cs .cs-guar-line b{font-weight:600}

/* Trust strip */
.an-cs .cs-trust{font-size:13px;color:var(--ink2)}

/* ---- TIERS ---- */
.an-cs .cs-tier-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;align-items:stretch}
.an-cs .cs-tier-card{display:flex;flex-direction:column;gap:6px;position:relative;cursor:pointer}
.an-cs .cs-tier-radio{position:absolute;opacity:0;width:0;height:0;pointer-events:none}
.an-cs .cs-tier-radio:checked+.cs-tier-card{border:1.5px solid var(--amber);background:var(--sel)}
.an-cs .cs-tier-dot{width:20px;height:20px;border:1.5px solid var(--line);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.an-cs .cs-tier-radio:checked~.cs-tier-card .cs-tier-dot{border-color:var(--amber)}
.an-cs .cs-tier-radio:checked~.cs-tier-card .cs-tier-dot::after{content:"";width:10px;height:10px;background:var(--amber);border-radius:50%}
.an-cs .cs-tier-badge{position:absolute;top:-12px;left:20px;background:var(--amber);color:#fff;font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;padding:4px 10px;border-radius:999px}

/* ---- FAQ ---- */
.an-cs details{border-top:1px solid var(--line)}
.an-cs details:last-of-type{border-bottom:1px solid var(--line)}
.an-cs summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:20px 0;font-family:var(--display);font-weight:400;font-size:20px;line-height:1.3}
.an-cs summary::-webkit-details-marker{display:none}
.an-cs summary::after{content:"+";font-family:var(--body);font-weight:300;font-size:26px;color:var(--amber);line-height:1}
.an-cs details[open] summary::after{content:"\2212"}
.an-cs details p{margin:0 0 22px;color:var(--ink2);font-size:15.5px;line-height:1.6;max-width:760px}

/* Facts */
.an-cs table{width:100%;border-collapse:collapse;font-size:14.5px}
.an-cs td{padding:9px 0;border-bottom:1px solid var(--line);vertical-align:top}
.an-cs td:last-child{text-align:right;white-space:nowrap;padding-left:12px}

/* Founder video */
.an-cs .cs-video{background:var(--cream);border-radius:20px;aspect-ratio:4/5;max-height:520px;width:100%;overflow:hidden;position:relative}
.an-cs .cs-video iframe{position:absolute;inset:0;width:100%;height:100%;border:0}


/* ---- Mobile ---- */
@media(max-width:860px){
  .an-cs .wrap{padding:44px 20px}
  .an-cs .h2{font-size:28px}
  .an-cs .g2,.an-cs .g3,.an-cs .g4,.an-cs .cs-tier-grid{grid-template-columns:1fr}

  .an-cs .cs-logo{height:52px}
  .an-cs .cs-header-in{padding:4px 16px}
  .an-cs .cs-bar{font-size:12.5px;line-height:1.4;padding:9px 16px}

  /* Hero: collapse to single column, reorder */
  .an-cs .cs-hero{padding:22px 20px 40px;flex-direction:column;gap:16px}
  .an-cs .cs-buy{display:contents}
  .an-cs .cs-hero-eyebrow{order:10}
  .an-cs .cs-hero h1{order:20;font-size:32px;line-height:1.08;letter-spacing:-.01em}
  .an-cs .cs-hero-sub{order:30;font-size:17px}
  .an-cs .cs-offer{order:40}
  .an-cs .cs-cta-wrap{order:50}
  .an-cs .cs-guar-line{order:70}
  .an-cs .cs-app-card{order:80}
  .an-cs .cs-hero-img{order:85;min-height:0;aspect-ratio:1/0.86;border-radius:18px;flex:none}
  .an-cs .cs-benefits{order:90}
  .an-cs .cs-trust{order:100}
  .an-cs .cs-seal{left:14px;bottom:14px;width:84px;height:84px}
  .an-cs .cs-seal-num{font-size:28px}
  .an-cs .cs-seal-lbl{font-size:8px;margin-top:3px}
  .an-cs .cs-vibe-icon{width:40px;height:40px}

  /* Offer card phone layout */
  .an-cs .cs-offer{border-radius:14px;padding:12px 14px;gap:4px}
  .an-cs .cs-offer-top{gap:12px}
  .an-cs .cs-offer-name{font-size:19px}
  .an-cs .cs-offer-detail{font-size:12.5px}
  .an-cs .cs-offer-price{font-size:21px}
  .an-cs .cs-offer-save{font-size:12.5px}
  .an-cs .cs-offer-bonus{font-size:12.5px}
  .an-cs .cs-offer-bal{font-size:12.5px}

  /* Founder */
  .an-cs .cs-founder-grid{grid-template-columns:1fr !important}
}

@media(prefers-reduced-motion:reduce){.an-cs *{transition:none !important}}
</style>

{%- liquid
  assign holiday = section.settings.holiday_offer
  assign ship = section.settings.ship_date
  assign tiers = section.blocks | where: "type", "tier"
  assign facts = section.blocks | where: "type", "fact"
  assign faqs = section.blocks | where: "type", "faq"
-%}

<div class="an-cs">

{%- if section.settings.bar_show -%}
<div class="cs-bar">{{ section.settings.bar_text }}</div>
{%- endif -%}

<header class="cs-header">
<div class="cs-header-in">
<a href="/" aria-label="Anitya Labs" style="display:block;line-height:0">
<img src="{{ 'anitya-lockup-light.png' | asset_url }}" alt="Anitya Labs" class="cs-logo cs-logo-light" width="180" height="58">
<img src="{{ 'anitya-lockup-dark.png' | asset_url }}" alt="Anitya Labs" class="cs-logo cs-logo-dark" width="180" height="58">
</a>
</div>
</header>

<main>

{%- comment -%} ======== HERO ======== {%- endcomment -%}
<section class="cs-hero">

<div class="cs-hero-img">
<picture>
<source media="(min-width:861px)" srcset="{{ 'calm-stack-hero-desktop.png' | asset_url }}">
<img src="{{ 'calm-stack-hero-phone.png' | asset_url }}" alt="Morning Saffron and Evening Magnesium, the two Calm Stack jars" loading="eager" class="cs-hero-photo" width="960" height="826">
</picture>
<div class="cs-seal"><span class="cs-seal-num">60</span><span class="cs-seal-lbl">morning<br>guarantee</span></div>
</div>

<div class="cs-buy">
<div class="cs-hero-eyebrow">{{ section.settings.hero_eyebrow }}</div>
<h1>{% if section.settings.hero_title != blank %}{{ section.settings.hero_title }}{% else %}{{ product.title }}{% endif %}</h1>
<p class="cs-hero-sub">{{ section.settings.hero_lede }}</p>

<ul class="cs-benefits">
<li><svg class="chk" viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span><b>{{ section.settings.benefit_1_bold }}</b> <span class="sub">{{ section.settings.benefit_1 }}</span></span></li>
<li><svg class="chk" viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span><b>{{ section.settings.benefit_2_bold }}</b> <span class="sub">{{ section.settings.benefit_2 }}</span></span></li>
<li><svg class="chk" viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span><b>{{ section.settings.benefit_3_bold }}</b> <span class="sub">{{ section.settings.benefit_3 }}</span></span></li>
</ul>

<div class="cs-app-card">
<div class="cs-vibe-strip">
<span class="cs-vibe-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 15a4 4 0 0 1-.6-7.95A6 6 0 0 1 18 8.5 3.5 3.5 0 0 1 17.5 15H7z"/><path d="M9 18l-.8 2M12.5 18l-.8 2M16 18l-.8 2"/></svg></span>
<span class="cs-vibe-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 18a4 4 0 0 1-.6-7.95A6 6 0 0 1 18 11.5 3.5 3.5 0 0 1 17.5 18H7z"/></svg></span>
<span class="cs-vibe-icon amber"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 6.5a3.5 3.5 0 0 1 3.4 2.6"/><path d="M14 3v1.2M19.7 6.3l-.9.9M21 11.5h-1.2"/><path d="M6.5 19a3.5 3.5 0 0 1-.5-6.96A5 5 0 0 1 15.7 13.4 3 3 0 0 1 15.5 19h-9z"/></svg></span>
<span class="cs-vibe-icon amber"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="9" r="3.4"/><path d="M11 2.5v1.5M4.5 9H6M16 9h1.5M6.4 4.4l1 1M15.6 4.4l-1 1"/><path d="M9 21a3 3 0 0 1-.3-5.98A4 4 0 0 1 16 15.5 2.6 2.6 0 0 1 15.5 21H9z"/></svg></span>
<span class="cs-vibe-icon sel"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg></span>
<span class="cs-vibe-icon amber"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.3" fill="currentColor"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg></span>
</div>
<p style="font-size:14.5px;line-height:1.45"><b style="font-weight:500">{{ section.settings.app_card_bold }}</b> <span style="color:var(--ink2)">{{ section.settings.app_card_text }}</span></p>
</div>

{%- comment -%} Offer card — renders 2nd tier by default, JS updates on change {%- endcomment -%}
{%- assign def_tier = tiers[1] -%}
{%- assign def_var = product.variants[1] -%}
<div class="cs-offer" id="cs-offer">
<div class="cs-offer-top">
<div style="display:flex;gap:10px;align-items:baseline;flex-wrap:wrap">
<span class="cs-offer-name" id="cs-offer-name">{{ def_var.title }}</span>
<span class="cs-offer-detail" id="cs-offer-detail">{{ def_tier.settings.detail }}</span>
</div>
<div style="display:flex;gap:10px;align-items:baseline">
<span class="cs-offer-price" id="cs-offer-price">{{ def_var.price | money_without_trailing_zeros }}</span>
{%- if holiday and def_tier.settings.saving != blank -%}
<span class="cs-offer-save" id="cs-offer-save">save {{ def_tier.settings.saving }}</span>
{%- elsif def_tier.settings.saving_evergreen != blank -%}
<span class="cs-offer-save" id="cs-offer-save">save {{ def_tier.settings.saving_evergreen }}</span>
{%- else -%}
<span class="cs-offer-save" id="cs-offer-save"></span>
{%- endif -%}
</div>
</div>
{%- if holiday and def_tier.settings.bonus != blank -%}
<div class="cs-offer-bonus" id="cs-offer-bonus">{{ def_tier.settings.bonus }}</div>
{%- else -%}
<div class="cs-offer-bonus" id="cs-offer-bonus" style="display:none"></div>
{%- endif -%}
<div class="cs-offer-bal" id="cs-offer-bal">{{ def_tier.settings.balance }} · <a href="#tiers">See all three</a></div>
</div>

<div class="cs-cta-wrap">
<button type="submit" form="cs-product-form" class="btn" id="cs-hero-btn">Reserve for $10</button>
<p class="small" style="text-align:center">{{ section.settings.under_button }}</p>
</div>

<div class="cs-guar-line">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0;margin-top:1px"><path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3z"/><path d="M9 12l2.2 2.2L15 10.5"/></svg>
<p style="font-size:14px;line-height:1.45"><b>{{ section.settings.guarantee_bold }}</b> {{ section.settings.guarantee_text }}</p>
</div>

<p class="cs-trust">{{ section.settings.trust_strip }}</p>
</div>

</section>

{%- comment -%} ======== TIERS ======== {%- endcomment -%}
<section id="tiers" class="sep">
<div class="wrap">
<div style="text-align:center;max-width:680px;margin:0 auto 32px">
<div class="eyebrow">{{ section.settings.tiers_eyebrow }}</div>
<h2 class="h2">{{ section.settings.tiers_heading }}</h2>
<p class="lede">{{ section.settings.tiers_lede }}</p>
</div>

{%- form 'product', product, id: 'cs-product-form' -%}
<div class="cs-tier-grid">
{%- for block in tiers -%}
  {%- assign idx = forloop.index0 -%}
  {%- assign variant = product.variants[idx] -%}
  {%- if variant -%}
  <div style="position:relative">
    <input type="radio" name="id" value="{{ variant.id }}" id="cs-t-{{ block.id }}" class="cs-tier-radio" {% if forloop.index == 2 %}checked{% endif %}
      data-name="{{ variant.title }}"
      data-detail="{{ block.settings.detail }}"
      data-price="{{ variant.price | money_without_trailing_zeros }}"
      data-saving="{{ block.settings.saving }}"
      data-saving-eg="{{ block.settings.saving_evergreen }}"
      data-bonus="{{ block.settings.bonus }}"
      data-balance="{{ block.settings.balance }}"
    >
    <label for="cs-t-{{ block.id }}" class="card cs-tier-card" {{ block.shopify_attributes }}>
      {%- if block.settings.badge != blank -%}<span class="cs-tier-badge">{{ block.settings.badge }}</span>{%- endif -%}
