  var form = document.getElementById('cs-product-form');
  if (!form) return;
  var radios = form.querySelectorAll('input[name="id"]');
  var holiday = {{ holiday | json }};

  /* Offer card elements */
  var oName = document.getElementById('cs-offer-name');
  var oDetail = document.getElementById('cs-offer-detail');
  var oPrice = document.getElementById('cs-offer-price');
  var oSave = document.getElementById('cs-offer-save');
  var oBonus = document.getElementById('cs-offer-bonus');
  var oBal = document.getElementById('cs-offer-bal');
  function update() {
    radios.forEach(function(r) {
      if (!r.checked) return;
      if (oName) oName.textContent = r.dataset.name;
      if (oDetail) oDetail.textContent = r.dataset.detail;
      if (oPrice) oPrice.textContent = r.dataset.price;
      var sv = holiday ? r.dataset.saving : r.dataset.savingEg;
      if (oSave) { oSave.textContent = sv ? ('save ' + sv) : ''; oSave.style.display = sv ? '' : 'none'; }
      var bn = holiday ? r.dataset.bonus : '';
      if (oBonus) { oBonus.textContent = bn; oBonus.style.display = bn ? '' : 'none'; }
      if (oBal) {
        var link = oBal.querySelector('a');
        var linkHtml = link ? ' \u00b7 ' + link.outerHTML : '';
        oBal.innerHTML = r.dataset.balance + linkHtml;
      }
    });
  }
  radios.forEach(function(r) { r.addEventListener('change', update); });
  update();
})();
</script>

