{% comment %}
  Anitya Calm Stack product page. One section, every line of copy is a setting.
  Wrapper class .an-cs, all CSS scoped under it.
  Light by default; dark when html[data-theme="dark"].
{% endcomment %}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300&family=Inter:wght@400;500;600&display=swap">

<style>
  /* ---- Light tokens (default) ---- */
  .an-cs {
    --bg: #FFFFFF;
    --card: #FBFBFA;
    --ink: #1E1B16;
    --ink2: #6B655A;
    --faint: #8E877B;
    --line: #E5E5E2;
    --amber: #A0621C;
    --tier-sel-border: #A0621C;
    --tier-sel-bg: #F6F1E8;
    --tier-bg: #FBFBFA;
    --tier-border: #E5E5E2;
    --bar-bg: #A0621C;
    --bar-ink: #FFFFFF;
    --cream: #efe9dc;
    --display: Fraunces, Georgia, "Times New Roman", serif;
    --body: Inter, system-ui, -apple-system, "Segoe UI", sans-serif;
    background: var(--bg);
    color: var(--ink);
    font: 16px/1.55 var(--body);
    -webkit-font-smoothing: antialiased;
  }

  /* ---- Dark tokens ---- */
  [data-theme="dark"] .an-cs {
    --bg: #15140f;
    --card: #1a1813;
    --ink: #efe9dc;
    --ink2: #b8af9c;
    --faint: #9a927f;
    --line: #2b2820;
    --amber: #d9a86c;
    --tier-sel-border: #d9a86c;
    --tier-sel-bg: #221e17;
    --tier-bg: #1a1813;
    --tier-border: #3a362c;
    --bar-bg: #d9a86c;
    --bar-ink: #15140f;
    --cream: #efe9dc;
  }

  .an-cs * { box-sizing: border-box; }
  .an-cs .cs-wrap { max-width: 1200px; margin: 0 auto; padding-left: 20px; padding-right: 20px; }
  .an-cs h1, .an-cs h2, .an-cs h3 {
    font-family: var(--display); font-weight: 300; letter-spacing: -.012em; line-height: 1.08; margin: 0; color: var(--ink);
  }
  .an-cs p { margin: 0; }
  .an-cs a { color: var(--ink); }
  .an-cs a:hover { color: var(--amber); }

  /* Holiday bar */
  .an-cs .cs-bar {
    background: var(--bar-bg); color: var(--bar-ink);
    text-align: center; font-size: 13px; font-weight: 500;
    padding: 9px 16px;
  }

  /* Hero: two columns */
  .an-cs .cs-hero {
    display: flex; flex-wrap: wrap; gap: 36px; align-items: flex-start;
    padding: 28px 0 40px;
  }
  .an-cs .cs-images { flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
  .an-cs .cs-main-img {
    background: var(--cream); border-radius: 20px; overflow: hidden;
    aspect-ratio: 1 / 1; display: flex; align-items: center; justify-content: center;
  }
  .an-cs .cs-main-img img { width: 92%; height: auto; display: block; }
  .an-cs .cs-thumbs {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px;
  }
  .an-cs .cs-thumb {
    background: var(--cream); border-radius: 14px; overflow: hidden;
    aspect-ratio: 1 / 1; display: flex; align-items: center; justify-content: center;
  }
  .an-cs .cs-thumb img { width: 90%; height: auto; display: block; }

  /* Buying column */
  .an-cs .cs-buy { flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .an-cs .cs-eyebrow {
    font: 500 12px/1.4 var(--body); letter-spacing: .14em; text-transform: uppercase; color: var(--amber);
  }
  .an-cs .cs-title { font-size: clamp(36px, 5vw, 52px); line-height: 1.05; }
  .an-cs .cs-lede {
    font-family: var(--display); font-weight: 300; font-size: 21px; line-height: 1.4; color: var(--ink2);
  }
  .an-cs .cs-chips { display: flex; gap: 8px; flex-wrap: wrap; font-size: 13px; }
  .an-cs .cs-chip {
    border: 1px solid var(--line); border-radius: 999px; padding: 5px 12px;
  }

  /* Tier cards */
  .an-cs .cs-tiers { border: 0; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .an-cs .cs-tiers legend { font-size: 14px; font-weight: 500; margin-bottom: 10px; padding: 0; }
  .an-cs .cs-tier {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    width: 100%; min-height: 64px; padding: 14px 18px; border-radius: 14px;
    cursor: pointer; font: inherit; color: inherit; text-align: left;
    background: var(--tier-bg); border: 1px solid var(--tier-border);
    position: relative;
  }
  .an-cs .cs-tier:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }
  .an-cs .cs-tier-radio { position: absolute; opacity: 0; width: 0; height: 0; }
  .an-cs .cs-tier-radio:checked + .cs-tier {
    background: var(--tier-sel-bg); border: 1.5px solid var(--tier-sel-border);
  }
  .an-cs .cs-tier-name { font-family: var(--display); font-size: 20px; font-weight: 400; color: var(--ink); }
  .an-cs .cs-tier-detail { font-size: 13px; color: var(--ink2); }
  .an-cs .cs-tier-bonus { font-size: 12px; color: var(--amber); }
  .an-cs .cs-tier-price { font-size: 22px; font-weight: 500; color: var(--ink); flex-shrink: 0; }
  .an-cs .cs-tier-save { font-size: 13px; font-weight: 600; color: var(--amber); }

  /* Free-with box */
  .an-cs .cs-free {
    background: var(--card); border: 1px solid var(--line); border-radius: 16px;
    padding: 16px 18px; display: flex; flex-direction: column; gap: 10px;
  }
  .an-cs .cs-free-title {
    font: 500 12px/1.4 var(--body); letter-spacing: .14em; text-transform: uppercase; color: var(--faint);
  }
  .an-cs .cs-free-row { display: flex; gap: 12px; align-items: flex-start; }
  .an-cs .cs-free-row svg { flex-shrink: 0; margin-top: 2px; width: 20px; height: 20px; stroke: var(--amber); fill: none; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .an-cs .cs-free-row b { font-weight: 500; }
  .an-cs .cs-free-row .cs-sub { color: var(--ink2); }

  /* CTA button */
  .an-cs .cs-cta {
    display: flex; align-items: center; justify-content: center;
    min-height: 60px; border-radius: 14px;
    background: var(--ink); color: var(--bg);
    font: 600 17px var(--body); border: 0; cursor: pointer; width: 100%;
    text-decoration: none;
  }
  .an-cs .cs-cta:hover { opacity: .9; }
  .an-cs .cs-cta:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }
  .an-cs .cs-refund { font-size: 13px; color: var(--faint); }
  .an-cs .cs-gift { font-size: 13px; color: var(--ink2); }

  /* Section divider */
  .an-cs .cs-section { border-top: 1px solid var(--line); }
  .an-cs .cs-section-inner { padding: 44px 0; }

  /* Two jars */
  .an-cs .cs-jars { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
  .an-cs .cs-jar {
    background: var(--card); border: 1px solid var(--line); border-radius: 18px;
    padding: 22px; display: flex; flex-direction: column; gap: 8px;
  }
  .an-cs .cs-jar-eyebrow {
    font: 500 12px/1.4 var(--body); letter-spacing: .14em; text-transform: uppercase; color: var(--amber);
  }
  .an-cs .cs-jar h3 { font-style: italic; font-size: 34px; }
  .an-cs .cs-jar p { color: var(--ink2); }
  .an-cs .cs-jar .cs-claim { font-size: 14px; color: var(--ink); }

  /* Give it three weeks */
  .an-cs .cs-split {
    display: flex; flex-wrap: wrap; gap: 36px; align-items: flex-start;
  }
  .an-cs .cs-split-left { flex: 1 1 360px; min-width: 0; }
  .an-cs .cs-split-right { flex: 2 1 480px; min-width: 0; }
  .an-cs .cs-prose {
    display: flex; flex-direction: column; gap: 16px;
    font-family: var(--display); font-weight: 300; font-size: 21px; line-height: 1.45; color: var(--ink2);
  }

  /* Gift cards */
  .an-cs .cs-gifts { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
  .an-cs .cs-gift-card {
    border: 1px solid var(--line); border-radius: 18px; padding: 22px;
    display: flex; flex-direction: column; gap: 14px;
  }
  .an-cs .cs-gift-circle {
    width: 96px; height: 96px; border-radius: 50%;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
  }
  .an-cs .cs-gift-circle.outline { border: 1.5px solid var(--ink); }
  .an-cs .cs-gift-circle.filled { background: var(--amber); }
  .an-cs .cs-gift-circle svg { stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; fill: none; }
  .an-cs .cs-gift-circle .cs-circle-label { font-family: var(--display); font-size: 20px; color: var(--amber); }
  .an-cs .cs-gift-card h3 { font-family: var(--display); font-weight: 400; font-size: 24px; }
  .an-cs .cs-gift-card p { color: var(--ink2); }

  /* Facts panels */
  .an-cs .cs-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
  .an-cs .cs-fact {
    border: 1px solid var(--line); border-radius: 14px; padding: 18px; font-size: 14px;
  }
  .an-cs .cs-fact-header {
    font-weight: 600; font-size: 15px; border-bottom: 1px solid var(--line); padding-bottom: 8px; margin-bottom: 8px;
  }
  .an-cs .cs-fact-serving { color: var(--ink2); }
  .an-cs .cs-fact-row {
    display: flex; justify-content: space-between; gap: 12px;
    border-top: 1px solid var(--line); margin-top: 8px; padding-top: 8px;
  }
  .an-cs .cs-fact-other { color: var(--faint); margin-top: 10px; font-size: 13px; }

  /* Who made this */
  .an-cs .cs-who-text {
    font-family: var(--display); font-weight: 300; font-size: 21px; line-height: 1.45; color: var(--ink2);
  }
  .an-cs .cs-who-sign { font-size: 14px; color: var(--faint); margin-top: 14px; }

  /* FAQ */
  .an-cs .cs-faq { max-width: 820px; margin: 0 auto; }
  .an-cs .cs-faq details { border-bottom: 1px solid var(--line); padding: 16px 0; }
  .an-cs .cs-faq summary {
    font-weight: 500; cursor: pointer; list-style: none; min-height: 44px;
    display: flex; align-items: center;
  }
  .an-cs .cs-faq summary::-webkit-details-marker { display: none; }
  .an-cs .cs-faq summary:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }
  .an-cs .cs-faq details p { margin: 10px 0 0; color: var(--ink2); }

  /* Fine print */
  .an-cs .cs-fine {
    max-width: 820px; margin: 0 auto; padding: 24px 0;
    font-size: 12px; color: var(--faint);
  }


  /* Sticky pre-order bar */
  .an-cs .cs-sticky {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
    background: var(--bg); border-top: 1px solid var(--line);
    box-shadow: 0 -6px 20px rgba(0,0,0,.08);
    padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
    transform: translateY(110%); transition: transform .25s ease;
  }
  .an-cs .cs-sticky.is-on { transform: none; }
  .an-cs .cs-sticky-in { max-width: 1200px; margin: 0 auto; display: flex; gap: 14px; align-items: center; }
  .an-cs .cs-sticky-txt { display: flex; flex-direction: column; min-width: 0; line-height: 1.25; }
  .an-cs .cs-sticky-name { font-family: var(--display); font-size: 17px; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .an-cs .cs-sticky-sub { font-size: 12px; color: var(--ink2); }
  .an-cs .cs-sticky .cs-cta { flex: 1 1 auto; min-height: 52px; max-width: 360px; margin-left: auto; }
  .an-cs .cs-thumb { cursor: pointer; }
  .an-cs .cs-thumb.is-on { outline: 2px solid var(--amber); outline-offset: 2px; }

  /* ---- Mobile ---- */
  @media (max-width: 860px) {
    .an-cs .cs-hero { flex-direction: column; gap: 22px; padding: 16px 0 28px; }
    .an-cs .cs-section-inner { padding: 32px 0; }
    .an-cs .cs-split { flex-direction: column; gap: 28px; }
  }

  @media (prefers-reduced-motion: reduce) { .an-cs * { transition: none !important; } }
</style>

{%- liquid
  assign holiday = section.settings.holiday_offer
  assign ship_date = section.settings.ship_date
  assign tiers = section.blocks | where: "type", "tier"
  assign faqs = section.blocks | where: "type", "faq"
-%}

<div class="an-cs">

  {%- if section.settings.bar_show -%}
    <div class="cs-bar">{{ section.settings.bar_text }}</div>
  {%- endif -%}

  <div class="cs-wrap">
    <section class="cs-hero">

      {%- comment -%} Image gallery {%- endcomment -%}
      <div class="cs-images">
        <div class="cs-main-img">
          {%- if product.featured_image -%}
            {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'eager', alt: product.featured_image.alt }}
          {%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="cs-thumbs">
            {%- for img in product.images limit: 6 -%}
              <button type="button" class="cs-thumb{% if forloop.first %} is-on{% endif %}" data-full="{{ img | image_url: width: 1200 }}" aria-label="Show image {{ forloop.index }}" style="border:0;padding:0;font:inherit;">
                {{ img | image_url: width: 400 | image_tag: loading: 'lazy', alt: img.alt }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Buying column {%- endcomment -%}
      <div class="cs-buy">
        <div class="cs-eyebrow">{{ section.settings.hero_eyebrow }}</div>
        <h1 class="cs-title">{% if section.settings.hero_title != blank %}{{ section.settings.hero_title }}{% else %}{{ product.title }}{% endif %}</h1>
        <p class="cs-lede">{{ section.settings.hero_lede }}</p>
        <div class="cs-chips">
          <span class="cs-chip">{{ section.settings.chip_1 }}</span>
          <span class="cs-chip">{{ section.settings.chip_2 }}</span>
          <span class="cs-chip">{{ section.settings.chip_3 }}</span>
        </div>

        {%- form 'product', product, id: 'cs-product-form' -%}
          <fieldset class="cs-tiers">
            <legend>{{ section.settings.tier_legend }}</legend>
            {%- for block in tiers -%}
              {%- assign idx = forloop.index0 -%}
              {%- assign variant = product.variants[idx] -%}
              {%- if variant -%}
                <input
                  type="radio"
                  name="id"
                  value="{{ variant.id }}"
                  id="cs-tier-{{ block.id }}"
                  class="cs-tier-radio"
                  {% if forloop.index == 2 %}checked{% endif %}
                  data-price="{{ variant.price | money }}"
                >
                <label for="cs-tier-{{ block.id }}" class="cs-tier" {{ block.shopify_attributes }}>
                  <span style="display:flex;flex-direction:column;gap:2px;min-width:0;">
                    <span style="display:flex;gap:10px;align-items:baseline;flex-wrap:wrap;">
                      <span class="cs-tier-name">{{ variant.title }}</span>
                    </span>
                    <span class="cs-tier-detail">{{ block.settings.detail }}</span>
                    {%- if holiday and block.settings.bonus != blank -%}
                      <span class="cs-tier-bonus">{{ block.settings.bonus }}</span>
                    {%- endif -%}
                  </span>
                  <span style="display:flex;flex-direction:column;align-items:flex-end;gap:2px;flex-shrink:0;">
                    <span class="cs-tier-price">{{ variant.price | money }}</span>
                    {%- if holiday -%}
                      {%- if block.settings.saving != blank -%}
                        <span class="cs-tier-save">{{ block.settings.saving }}</span>
                      {%- endif -%}
                    {%- else -%}
                      {%- if block.settings.saving_evergreen != blank -%}
                        <span class="cs-tier-save">{{ block.settings.saving_evergreen }}</span>
                      {%- endif -%}
                    {%- endif -%}
                  </span>
                </label>
              {%- endif -%}
            {%- endfor -%}
          </fieldset>

          <div class="cs-free">
            <div class="cs-free-title">{{ section.settings.free_heading }}</div>
            <div class="cs-free-row">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.5"/><circle cx="17" cy="17.5" r="1.5"/></svg>
              <span><b>{{ section.settings.free_line_1 }}</b></span>
            </div>
            <div class="cs-free-row">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              <span><b>{{ section.settings.free_line_2_bold }}</b> <span class="cs-sub">{{ section.settings.free_line_2 }}</span></span>
            </div>
            <div class="cs-free-row">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.3-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.7-7 10-7 10z"/></svg>
              <span><b>{{ section.settings.free_line_3_bold }}</b> <span class="cs-sub">{{ section.settings.free_line_3 }}</span></span>
            </div>
          </div>

          <button type="submit" class="cs-cta" id="cs-cta-btn">
            Pre-order &middot; {{ product.selected_or_first_available_variant.price | money }}
          </button>
        {%- endform -%}

        <p class="cs-refund">{{ section.settings.refund_line | replace: '[ship date]', ship_date }}</p>
        <p class="cs-gift">{{ section.settings.gift_line }}</p>
      </div>
      <div class="cs-sticky" id="cs-sticky" aria-hidden="true">
        <div class="cs-sticky-in">
          <div class="cs-sticky-txt">
            <span class="cs-sticky-name" id="cs-sticky-name"></span>
            <span class="cs-sticky-sub">{{ section.settings.free_line_1 }}</span>
          </div>
          <button type="submit" form="cs-product-form" class="cs-cta" id="cs-sticky-btn" tabindex="-1">Pre-order</button>
        </div>
      </div>

    </section>
  </div>

  {%- comment -%} Two jars, one routine {%- endcomment -%}
  <div class="cs-section">
    <div class="cs-wrap">
      <div class="cs-section-inner">
        <h2 style="margin-bottom:22px;">{{ section.settings.jars_heading }}</h2>
        <div class="cs-jars">
          <div class="cs-jar">
            <div class="cs-jar-eyebrow">{{ section.settings.usha_eyebrow }}</div>
            <h3>Usha</h3>
            <p>{{ section.settings.usha_body }}</p>
            <p class="cs-claim">{{ section.settings.usha_claim }}</p>
          </div>
          <div class="cs-jar">
            <div class="cs-jar-eyebrow">{{ section.settings.sandhya_eyebrow }}</div>
            <h3>Sandhya</h3>
            <p>{{ section.settings.sandhya_body }}</p>
            <p class="cs-claim">{{ section.settings.sandhya_claim }}</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Give it three weeks {%- endcomment -%}
  <div class="cs-section">
    <div class="cs-wrap">
      <div class="cs-section-inner">
        <div class="cs-split">
          <div class="cs-split-left">
            <h2>{{ section.settings.weeks_heading }}</h2>
          </div>
          <div class="cs-split-right cs-prose">
            <p>{{ section.settings.weeks_p1 }}</p>
            <p>{{ section.settings.weeks_p2 }}</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} With every stack {%- endcomment -%}
  <div class="cs-section">
    <div class="cs-wrap">
      <div class="cs-section-inner">
        <h2 style="margin-bottom:20px;">{{ section.settings.gifts_heading }}</h2>
        <div class="cs-gifts">
          {%- for block in section.blocks -%}{%- if block.type == 'gift' -%}
          <div class="cs-gift-card" {{ block.shopify_attributes }}>
            {%- case block.settings.icon -%}
            {%- when 'heart' -%}
            <div class="cs-gift-circle filled">
              <svg width="34" height="34" viewBox="0 0 24 24" stroke="var(--bg)" aria-hidden="true"><path d="M12 20s-7-4.3-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.7-7 10-7 10z"/></svg>
            </div>
            {%- when 'van' -%}
            <div class="cs-gift-circle outline">
              <svg width="34" height="34" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.5"/><circle cx="17" cy="17.5" r="1.5"/></svg>
            </div>
            {%- else -%}
            <div class="cs-gift-circle outline">
              <svg width="22" height="22" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"/></svg>
              {%- if block.settings.circle_label != blank -%}<span class="cs-circle-label">{{ block.settings.circle_label }}</span>{%- endif -%}
            </div>
            {%- endcase -%}
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.body }}</p>
          </div>
          {%- endif -%}{%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} What's in it, plainly {%- endcomment -%}
  <div class="cs-section">
    <div class="cs-wrap">
      <div class="cs-section-inner">
        <div class="cs-split">
          <div class="cs-split-left" style="display:flex;flex-direction:column;gap:14px;">
            <h2>{{ section.settings.facts_heading }}</h2>
            <p style="color:var(--ink2);">{{ section.settings.facts_intro }}</p>
          </div>
          <div class="cs-split-right">
            <div class="cs-facts">
              {%- for block in section.blocks -%}{%- if block.type == 'fact' -%}
              <div class="cs-fact" {{ block.shopify_attributes }}>
                <div class="cs-fact-header">{{ block.settings.title }}</div>
                <div class="cs-fact-serving">{{ block.settings.serving }}</div>
                <div class="cs-fact-row"><span>{{ block.settings.ingredient }}</span><span>{{ block.settings.amount }}</span></div>
                <div class="cs-fact-other">{{ block.settings.other }}</div>
              </div>
              {%- endif -%}{%- endfor -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Who made this {%- endcomment -%}
  <div class="cs-section">
    <div class="cs-wrap">
      <div class="cs-section-inner">
        <div class="cs-split">
          <div class="cs-split-left">
            <h2>{{ section.settings.who_heading }}</h2>
          </div>
          <div class="cs-split-right" style="display:flex;flex-direction:column;gap:14px;">
            <p class="cs-who-text">{{ section.settings.who_body | newline_to_br }}</p>
            <p class="cs-who-sign">{{ section.settings.who_sign }}</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Questions {%- endcomment -%}
  <div class="cs-section">
    <div class="cs-wrap">
      <div class="cs-section-inner cs-faq">
        <h2 style="margin-bottom:20px;">{{ section.settings.faq_heading }}</h2>
        {%- for block in faqs -%}
          <details {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <p>{{ block.settings.answer }}</p>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} Fine print {%- endcomment -%}
  <div class="cs-section">
    <div class="cs-wrap">
      <p class="cs-fine">{{ section.settings.fda_line }}</p>
    </div>
  </div>

</div>

<script>
  (function(){
    var form = document.getElementById('cs-product-form');
    if (!form) return;
    var btn = document.getElementById('cs-cta-btn');
    var radios = form.querySelectorAll('input[name="id"]');
    var sbtn = document.getElementById('cs-sticky-btn');
    var sname = document.getElementById('cs-sticky-name');
    var sticky = document.getElementById('cs-sticky');
    function update() {
      radios.forEach(function(r) {
        if (r.checked) {
          var t = 'Pre-order \u00b7 ' + r.getAttribute('data-price');
          if (btn) btn.textContent = t;
          if (sbtn) sbtn.textContent = t;
          var lab = form.querySelector('label[for="' + r.id + '"] .cs-tier-name');
          if (sname && lab) sname.textContent = lab.textContent;
        }
      });
    }
    radios.forEach(function(r) { r.addEventListener('change', update); });
    update();
    if (sticky && btn && 'IntersectionObserver' in window) {
      var io = new IntersectionObserver(function(entries) {
        var e = entries[0];
        var show = !e.isIntersecting && e.boundingClientRect.top < 0;
        sticky.classList.toggle('is-on', show);
        sticky.setAttribute('aria-hidden', show ? 'false' : 'true');
        if (sbtn) sbtn.tabIndex = show ? 0 : -1;
      });
      io.observe(btn);
    }
    var main = document.querySelector('.an-cs .cs-main-img img');
    document.querySelectorAll('.an-cs .cs-thumb').forEach(function(t) {
      t.addEventListener('click', function() {
        if (!main) return;
        main.src = t.getAttribute('data-full');
        main.removeAttribute('srcset');
        document.querySelectorAll('.an-cs .cs-thumb').forEach(function(x) { x.classList.remove('is-on'); });
        t.classList.add('is-on');
      });
    });
  })();
</script>

